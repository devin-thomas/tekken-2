+/* Tekken 2 patch 0012: a port the title supplies (psx_title_hooks.h). Always
+ * connected; digital unless the title asks for analog. */
+static int title_debug_pad_armed(void) {
+#ifndef PSX_NO_DEBUG_TOOLS
+    return debug_server_get_host_pad(nullptr, nullptr, nullptr, nullptr) ? 1 : 0;
+#else
+    return 0;
+#endif
+}
+static int capture_title_pad(PsxNetPad* out, const PsxTitlePad& tp, bool guarded) {
+    const bool analog = tp.analog != 0;
+    out->buttons = tp.buttons;
+    out->lx = analog ? tp.sticks[0] : 0x80; out->ly = analog ? tp.sticks[1] : 0x80;
+    out->rx = analog ? tp.sticks[2] : 0x80; out->ry = analog ? tp.sticks[3] : 0x80;
+    out->analog = analog ? SIO_PAD_DUALSHOCK : SIO_PAD_DIGITAL;
+    out->connected = 1;
+    if (guarded) {
+        out->buttons = 0xFFFFu;
+        out->lx = out->ly = out->rx = out->ry = 0x80u;
+    }
+    return 1;
+}
