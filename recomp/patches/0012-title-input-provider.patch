diff --git a/runtime/src/psx_title_hooks.c b/runtime/src/psx_title_hooks.c
new file mode 100644
index 00000000..aea41bce
--- /dev/null
+++ b/runtime/src/psx_title_hooks.c
@@ -0,0 +1,43 @@
+/* psx_title_hooks.c -- Tekken 2 patch 0012: the title hook registry
+ * (psx_title_hooks.h). */
+#include "psx_title_hooks.h"
+
+#include <stddef.h>
+
+static const PsxTitleHooks *s_hooks = NULL;
+
+int psx_title_set_hooks(const PsxTitleHooks *hooks) {
+    if (hooks && hooks->abi != PSX_TITLE_HOOKS_ABI) return 0;
+    s_hooks = hooks;
+    return 1;
+}
+
+const PsxTitleHooks *psx_title_hooks(void) { return s_hooks; }
+
+void psx_title_early(const char *home_dir) {
+    if (s_hooks && s_hooks->early) s_hooks->early(home_dir);
+}
+
+int psx_title_event(const void *sdl_event) {
+    return s_hooks && s_hooks->event ? s_hooks->event(sdl_event) : 0;
+}
+
+void psx_title_tick(void) {
+    if (s_hooks && s_hooks->tick) s_hooks->tick();
+}
+
+int psx_title_pads_active(void) { return s_hooks && s_hooks->pad; }
+
+int psx_title_pad(int port, PsxTitlePad *out) {
+    if (!s_hooks || !s_hooks->pad || !out || port < 0 || port > 1) return 0;
+    return s_hooks->pad(port, out);
+}
+
+int psx_title_layer(int index, int canvas_w, int canvas_h, float px_per_unit,
+                    PsxTitleLayer *out) {
+    if (!s_hooks || !s_hooks->layer || !out || index < 0 || index >= PSX_TITLE_LAYERS ||
+        canvas_w <= 0 || canvas_h <= 0)
+        return 0;
+    if (!s_hooks->layer(index, canvas_w, canvas_h, px_per_unit, out)) return 0;
+    return out->pixels && out->w > 0 && out->h > 0 && out->dw > 0 && out->dh > 0;
+}
