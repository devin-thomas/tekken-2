+/* psx_title_hooks.h -- Tekken 2 patch 0012: hooks a title's own code uses to
+ * supply the pads, see every host event, run once a host tick, and draw its
+ * own layers over the picture (patch 0013), without the recomp-ui launcher.
+ *
+ * Every hook is inert until a title registers: a build without a title hook
+ * set runs exactly as before. Register from a static initializer
+ * (PSX_MOD_CONSTRUCTOR in mod_plugins.h), before main().
+ *
+ * Threads: early, event, tick and pad run on the main (emulation) thread;
+ * layer runs on whichever thread presents (the render thread when it is on). */
+#ifndef PSX_TITLE_HOOKS_H
+#define PSX_TITLE_HOOKS_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PSX_TITLE_HOOKS_ABI 1
+
+typedef struct PsxTitlePad {
+    uint16_t buttons;     /* the PSX pad word, active low (0xFFFF: nothing held) */
+    uint8_t sticks[4];    /* lx, ly, rx, ry; 0x80 centred */
+    int analog;           /* 1: present as an analog DualShock; 0: a digital pad */
+} PsxTitlePad;
+
+/* One image the title draws over everything (patch 0013). */
+typedef struct PsxTitleLayer {
+    const uint32_t *pixels;   /* ARGB8888 (0xAARRGGBB), straight alpha, top row first */
+    int w, h;                 /* the image's size in pixels */
+    int x, y, dw, dh;         /* where it goes, in canvas units */
+    uint32_t version;         /* changes whenever the pixels do: the renderer
+                               * uploads the image only then */
+    int opaque;               /* set by the renderer before the call: 1 when it
+                               * copies pixels with no blending or scaling
+                               * (Vulkan): give an opaque image with w == dw,
+                               * h == dh, in canvas pixels (px_per_unit 1) */
+} PsxTitleLayer;
+
+#define PSX_TITLE_LAYERS 2
+
+typedef struct PsxTitleHooks {
+    int abi;                  /* PSX_TITLE_HOOKS_ABI */
+    /* main(), once the per-user home (settings.toml's folder) is known and
+     * before SDL_Init: a title sets SDL hints and environment switches here.
+     * The runtime then reads PSX_AUDIO_BUFFER_MS (milliseconds) over game.toml's
+     * audio_buffer_ms. */
+    void (*early)(const char *home_dir);
+    /* Every host SDL event (an SDL_Event*), first, in the game and in every
+     * host pause. Returns 1 to consume it. */
+    int (*event)(const void *sdl_event);
+    /* Once per host service: every frame while the game runs, every few
+     * milliseconds while a host pause holds it. */
+    void (*tick)(void);
+    /* Ports 0 and 1: return 1 and fill *out to supply that port's pad. A
+     * supplied port is always connected. The runtime's own seats, keyboard
+     * map and controller handles then stay out of those ports. */
+    int (*pad)(int port, PsxTitlePad *out);
+    /* Layer i (0..PSX_TITLE_LAYERS-1) over the picture and every host
+     * overlay: return 1 and fill *out to show it. canvas_w/canvas_h is the
+     * space the renderer draws in (OpenGL: the window's drawable pixels; the
+     * SDL renderer: its logical size), px_per_unit the device pixels in one
+     * canvas unit, so an image drawn at dw*px_per_unit pixels is sharp. The
+     * pixels must stay valid until the next call. */
+    int (*layer)(int index, int canvas_w, int canvas_h, float px_per_unit, PsxTitleLayer *out);
+} PsxTitleHooks;
+
+/* Register (NULL clears). Refuses another ABI version (returns 0). */
+int psx_title_set_hooks(const PsxTitleHooks *hooks);
+const PsxTitleHooks *psx_title_hooks(void);
+
+/* Runtime side. */
+void psx_title_early(const char *home_dir);
+int  psx_title_event(const void *sdl_event);
+void psx_title_tick(void);
+int  psx_title_pad(int port, PsxTitlePad *out);
+int  psx_title_pads_active(void);   /* the title supplies the pads */
+int  psx_title_layer(int index, int canvas_w, int canvas_h, float px_per_unit, PsxTitleLayer *out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
