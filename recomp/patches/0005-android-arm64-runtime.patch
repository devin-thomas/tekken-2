diff --git a/runtime/src/android_touch_pad.c b/runtime/src/android_touch_pad.c
new file mode 100644
index 00000000..5ecb5b7d
--- /dev/null
+++ b/runtime/src/android_touch_pad.c
@@ -0,0 +1,41 @@
+/* android_touch_pad.c (Tekken 2 patch 0005): the Android app shell's on-screen
+ * controller. T2Activity's TouchPadView handles the touches on the UI thread
+ * and passes the set of held PS buttons here; the runtime reads it as Player
+ * 1's host pad layer (main.cpp host_pad_layer), the same route the debug
+ * server's virtual pad takes, so menus, shortcuts and the guest pad all see it
+ * like a connected controller. One atomic word, no queue: the game thread
+ * samples whatever is held when it polls the pad. */
+#if defined(__ANDROID__)
+#include <jni.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <string.h>
+
+/* PSX pad bits, active high here (1 = held): Select 0x0001, Start 0x0008,
+ * Up 0x0010, Right 0x0020, Down 0x0040, Left 0x0080, L2 0x0100, R2 0x0200,
+ * L1 0x0400, R1 0x0800, Triangle 0x1000, Circle 0x2000, X 0x4000,
+ * Square 0x8000. */
+static _Atomic uint32_t s_held;
+
+JNIEXPORT void JNICALL
+Java_com_uppercutlabs_tekken2recomp_TouchPadView_nativeSetHeld(JNIEnv *env, jclass cls,
+                                                               jint held)
+{
+    (void)env; (void)cls;
+    atomic_store_explicit(&s_held, (uint32_t)held & 0xFFFFu, memory_order_release);
+}
+
+/* 1 while any on-screen button is held: *buttons gets the active-low PSX
+ * word, sticks centred, triggers released. 0 when nothing is held, so a
+ * keyboard or controller keeps working through the normal path. */
+int psx_android_touch_pad(uint16_t *buttons, uint8_t st[4], uint8_t *lt, uint8_t *rt)
+{
+    const uint32_t held = atomic_load_explicit(&s_held, memory_order_acquire);
+    if (!held) return 0;
+    if (buttons) *buttons = (uint16_t)(~held & 0xFFFFu);
+    if (st) memset(st, 0x80, 4);
+    if (lt) *lt = 0;
+    if (rt) *rt = 0;
+    return 1;
+}
+#endif
