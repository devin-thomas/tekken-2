+/* Android (Tekken 2 patch 0005): stdout/stderr of an app process go nowhere.
+ * Forward every line to logcat (tag "psxrecomp") and append it to
+ * <files>/psxrecomp.log, which `adb shell run-as <package> cat
+ * files/psxrecomp.log` reads on a debug build. */
+#include <android/log.h>
+#include <pthread.h>
+#include <unistd.h>
+static int s_android_log_fd = -1;
+static void* android_log_pump(void* arg) {
+    const int fd = (int)(intptr_t)arg;
+    FILE* in = fdopen(fd, "r");
+    if (!in) return nullptr;
+    char line[4096];
+    while (std::fgets(line, sizeof line, in)) {
+        size_t n = std::strlen(line);
+        if (s_android_log_fd >= 0) (void)!write(s_android_log_fd, line, n);
+        if (n && line[n - 1] == '\n') line[--n] = 0;
+        __android_log_write(ANDROID_LOG_INFO, "psxrecomp", line);
+    }
+    return nullptr;
+}
+static void android_redirect_stdio(void) {
+    int fds[2];
+    if (pipe(fds) != 0) return;
+    if (const char* storage = SDL_GetAndroidInternalStoragePath();
+        storage && storage[0]) {
+        std::string path = std::string(storage) + "/psxrecomp.log";
+        s_android_log_fd = open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+    }
+    dup2(fds[1], 1);
+    dup2(fds[1], 2);
+    close(fds[1]);
+    pthread_t t;
+    if (pthread_create(&t, nullptr, android_log_pump, (void*)(intptr_t)fds[0]) == 0)
+        pthread_detach(t);
+}
+#endif
