+#elif defined(__ANDROID__) && defined(__aarch64__)
+
+/* Android/AArch64. Bionic declares ucontext_t but implements none of
+ * getcontext/makecontext/swapcontext, so switch the AAPCS64 callee-saved state
+ * (x19-x30, sp, d8-d15) directly. Fibers are cooperative and never migrate
+ * between threads, as with the other backends.
+ *
+ * Tekken 2 patch 0005. Adapted from douglasjv's "Add shared Android runtime
+ * packaging" (psxrecomp fork commit 19233f496fe810fb57afc226b4ff4509c812bc8f,
+ * 2026-07-13), offered to psxrecomp and so under psxrecomp's licence. */
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct psx_aarch64_context {
+    uint64_t x19_x30[12];
+    uint64_t sp;
+    uint64_t d8_d15[8];
+} psx_aarch64_context;
+
+typedef struct psx_fiber_impl {
+    psx_aarch64_context ctx;   /* must stay first: the swap addresses it */
+    void*               stack; /* NULL for the thread-fiber */
+    psx_fiber_entry     entry;
+    void*               arg;
+} psx_fiber_impl;
+
+/* Cooperative + single-threaded, as in the POSIX backend. */
+static psx_fiber_impl* s_current = NULL;
+
+/* x0 = save into, x1 = load from. Returns into the loaded x30. */
+__attribute__((naked, noinline)) static void
+psx_fiber_swap(psx_aarch64_context* from, psx_aarch64_context* to)
+{
+    __asm__ volatile(
+        "stp x19, x20, [x0, #0]\n"
+        "stp x21, x22, [x0, #16]\n"
+        "stp x23, x24, [x0, #32]\n"
+        "stp x25, x26, [x0, #48]\n"
+        "stp x27, x28, [x0, #64]\n"
+        "stp x29, x30, [x0, #80]\n"
+        "mov x2, sp\n"
+        "str x2, [x0, #96]\n"
+        "stp d8, d9, [x0, #104]\n"
+        "stp d10, d11, [x0, #120]\n"
+        "stp d12, d13, [x0, #136]\n"
+        "stp d14, d15, [x0, #152]\n"
+        "ldp d8, d9, [x1, #104]\n"
+        "ldp d10, d11, [x1, #120]\n"
+        "ldp d12, d13, [x1, #136]\n"
+        "ldp d14, d15, [x1, #152]\n"
+        "ldr x2, [x1, #96]\n"
+        "mov sp, x2\n"
+        "ldp x19, x20, [x1, #0]\n"
+        "ldp x21, x22, [x1, #16]\n"
+        "ldp x23, x24, [x1, #32]\n"
+        "ldp x25, x26, [x1, #48]\n"
+        "ldp x27, x28, [x1, #64]\n"
+        "ldp x29, x30, [x1, #80]\n"
+        "ret\n");
+}
+
+static void psx_fiber_trampoline(void)
+{
+    psx_fiber_impl* f = s_current;
+    f->entry(f->arg);
+    /* The BIOS thread entry never returns normally; see the POSIX backend. */
+    abort();
+}
+
+psx_fiber_t psx_fiber_convert_thread(void)
+{
+    if (!s_current)
+        s_current = (psx_fiber_impl*)calloc(1, sizeof(*s_current));
+    return (psx_fiber_t)s_current;
+}
+
+psx_fiber_t psx_fiber_current(void) { return (psx_fiber_t)s_current; }
+
+psx_fiber_t psx_fiber_create(size_t stack_size, psx_fiber_entry entry, void* arg)
+{
+    if (stack_size < 65536) stack_size = 65536;
+    psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+    if (!f) return NULL;
+    f->stack = malloc(stack_size);
+    if (!f->stack) { free(f); return NULL; }
+    f->entry = entry;
+    f->arg   = arg;
+    uintptr_t top = ((uintptr_t)f->stack + stack_size) & ~(uintptr_t)15;
+    f->ctx.sp = (uint64_t)top;
+    f->ctx.x19_x30[10] = 0;                                   /* x29: frame chain end */
+    f->ctx.x19_x30[11] = (uint64_t)(uintptr_t)psx_fiber_trampoline;  /* x30 */
+    return (psx_fiber_t)f;
+}
+
+void psx_fiber_switch(psx_fiber_t target)
+{
+    psx_fiber_impl* to   = (psx_fiber_impl*)target;
+    psx_fiber_impl* from = s_current;
+    if (!to || !from || to == from) return;
+    s_current = to;
+    psx_fiber_swap(&from->ctx, &to->ctx);
+}
+
+void psx_fiber_destroy(psx_fiber_t fiber)
+{
+    psx_fiber_impl* f = (psx_fiber_impl*)fiber;
+    if (!f) return;
+    free(f->stack);
+    free(f);
+}
+
 #else /* POSIX: ucontext */
 
