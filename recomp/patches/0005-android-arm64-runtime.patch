diff --git a/runtime/src/gl_android_shims.c b/runtime/src/gl_android_shims.c
new file mode 100644
index 00000000..5ff8e20e
--- /dev/null
+++ b/runtime/src/gl_android_shims.c
@@ -0,0 +1,28 @@
+/* gl_android_shims.c (Tekken 2 patch 0005): desktop GL 1.x entry points that
+ * gpu_gl_renderer.c calls directly and that Android's libGLESv3 does not
+ * export. The GL backend is never selected on Android (main.cpp falls back
+ * to the software renderer), so these exist only to let the shared library
+ * load; bionic binds every symbol at load time. */
+#if defined(__ANDROID__)
+#include <GLES3/gl3.h>
+#include <android/log.h>
+
+static void shim_once(const char *name)
+{
+    static int warned;
+    if (!warned) {
+        warned = 1;
+        __android_log_print(ANDROID_LOG_WARN, "psxrecomp",
+                            "desktop-only GL call %s on Android ignored", name);
+    }
+}
+
+void glClearDepth(double depth) { glClearDepthf((GLfloat)depth); }
+
+void glGetTexImage(GLenum target, GLint level, GLenum format, GLenum type,
+                   void *pixels)
+{
+    (void)target; (void)level; (void)format; (void)type; (void)pixels;
+    shim_once("glGetTexImage");
+}
+#endif
