diff --git a/runtime/tests/test_sio_timing.c b/runtime/tests/test_sio_timing.c
new file mode 100644
index 00000000..087c5bfd
--- /dev/null
+++ b/runtime/tests/test_sio_timing.c
@@ -0,0 +1,41 @@
+/* Tekken 2 patch 0011: SIO0 byte and /ACK timing (sio_timing.h). Values from
+ * PSX-SPX "Controller and Memory Card I/O Ports" (JOY_BAUD x 8 per byte, BIOS
+ * baud 0088h) and DuckStation ffb33c28 measured with Tekken 2 (difftrace IO
+ * log: IRQ7 1,538 cycles after a pad byte's write, 1,258 after a card byte's).
+ */
+
+#include "sio_timing.h"
+
+#include <stdio.h>
+
+static int s_fail, s_checks;
+
+static void check(int ok, const char *what, unsigned got, unsigned want) {
+    s_checks++;
+    if (!ok) {
+        s_fail++;
+        fprintf(stderr, "FAIL %s: got %u, want %u\n", what, got, want);
+    }
+}
+
+int main(void) {
+    /* Off (ENHANCED): the legacy 1,088 + 170 for every device and baud. */
+    check(sio_timing_transfer_cycles(0, 0x88) == 1088u, "off: transfer", sio_timing_transfer_cycles(0, 0x88), 1088);
+    check(sio_timing_transfer_cycles(0, 0x44) == 1088u, "off: baud ignored", sio_timing_transfer_cycles(0, 0x44), 1088);
+    check(sio_timing_ack_cycles(0, 0) == 170u, "off: pad ack", sio_timing_ack_cycles(0, 0), 170);
+    check(sio_timing_ack_cycles(0, 1) == 170u, "off: card ack", sio_timing_ack_cycles(0, 1), 170);
+
+    /* On (REFERENCE): JOY_BAUD x 8; the BIOS rate when JOY_BAUD is 0. */
+    check(sio_timing_transfer_cycles(1, 0x88) == 1088u, "on: bios baud", sio_timing_transfer_cycles(1, 0x88), 1088);
+    check(sio_timing_transfer_cycles(1, 0x44) == 544u, "on: double rate", sio_timing_transfer_cycles(1, 0x44), 544);
+    check(sio_timing_transfer_cycles(1, 0) == 1088u, "on: baud 0", sio_timing_transfer_cycles(1, 0), 1088);
+
+    /* On: the IRQ7 after a pad byte at 1,538, after a card byte at 1,258. */
+    check(sio_timing_transfer_cycles(1, 0x88) + sio_timing_ack_cycles(1, 0) == 1538u, "on: pad irq7",
+          sio_timing_transfer_cycles(1, 0x88) + sio_timing_ack_cycles(1, 0), 1538);
+    check(sio_timing_transfer_cycles(1, 0x88) + sio_timing_ack_cycles(1, 1) == 1258u, "on: card irq7",
+          sio_timing_transfer_cycles(1, 0x88) + sio_timing_ack_cycles(1, 1), 1258);
+
+    printf("sio_timing_test: %d of %d checks passed\n", s_checks - s_fail, s_checks);
+    return s_fail ? 1 : 0;
+}
