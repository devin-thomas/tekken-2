+#ifndef PSXRECOMP_SIO_TIMING_H
+#define PSXRECOMP_SIO_TIMING_H
+
+/* SIO0 byte and /ACK timing on the DuckStation reference (Tekken 2 patch 0011).
+ *
+ * A byte on the controller/memory card port shifts out at the JOY_BAUD rate:
+ * 8 bits at the reload value each, JOY_BAUD x 8 CPU cycles (PSX-SPX
+ * "Controller and Memory Card I/O Ports": 1F80104Eh, BIOS value 0088h, so
+ * 1,088). The device's /ACK pulse then arrives after a device-specific delay
+ * (PSX-SPX: "about 10us" for joypads; memory cards answer sooner). Measured on
+ * DuckStation ffb33c28 with Tekken 2 (difftrace IO log, tools/diff): the IRQ7
+ * of a pad byte comes 1,538 cycles after the JOY_DATA write (1,088 + 450), a
+ * memory card byte's 1,258 (1,088 + 170), RX data ready 1,088 after the write
+ * on both. psxrecomp gave every device 1,088 + 170 and ignored JOY_BAUD.
+ *
+ * On in REFERENCE builds, off in ENHANCED; PSX_SIO_TIMING=1/0 overrides
+ * (sio.c). */
+
+#include "execution_profile.h"
+
+#include <stdint.h>
+
+#if defined(PSX_EXECUTION_PROFILE_CONFIG) && !PSX_EXECUTION_ENHANCED
+#define SIO_TIMING_DEFAULT 1
+#else
+#define SIO_TIMING_DEFAULT 0
+#endif
+
+#define SIO_LEGACY_TRANSFER_CYCLES 1088u
+#define SIO_LEGACY_ACK_CYCLES      170u
+#define SIO_PAD_ACK_CYCLES         450u
+#define SIO_CARD_ACK_CYCLES        170u
+
+/* Cycles a byte takes to shift, from JOY_BAUD (0 falls back to the BIOS rate). */
+static inline uint32_t sio_timing_transfer_cycles(int on, uint16_t baud) {
+    if (!on || baud == 0u) return SIO_LEGACY_TRANSFER_CYCLES;
+    return (uint32_t)baud * 8u;
+}
+
+/* Cycles from the end of a byte to the device's /ACK (and IRQ7). */
+static inline uint32_t sio_timing_ack_cycles(int on, int memory_card) {
+    if (!on) return SIO_LEGACY_ACK_CYCLES;
+    return memory_card ? SIO_CARD_ACK_CYCLES : SIO_PAD_ACK_CYCLES;
+}
+
+#endif
