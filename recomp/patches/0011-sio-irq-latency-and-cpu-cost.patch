  * mirrored across the first 8 MB of each segment (Kula World's crt0 parks $sp
@@ -2476,6 +2492,21 @@ static inline uint32_t psx_mmio_read_wait(uint32_t phys, uint32_t size) {
  * 0x20 = none (LWC2, dest is a GTE reg). size = access width in bytes (1/2/4). */
 static inline void psx_cyc_readmem(CPUState* cpu, uint32_t phys, uint32_t size,
                                    uint32_t compl_cost, uint32_t arm_rt) {
+    if (psx_cpu_cost_ds()) {
+        /* DuckStation: RAM +6, BIOS ROM its access time, scratchpad free,
+         * devices their wait; no fudge, completion or give-back. */
+        cpu->ld_absorb = 0u;
+        cpu->ld_which_t = 0x20u;
+        (void)compl_cost; (void)arm_rt;
+        if (phys < 0x00800000u) { psx_cpu_charge(PSX_DS_RAM_READ_CYCLES); return; }
+        if (phys >= 0x1F800000u && phys <= 0x1F8003FFu) return;
+        if (psx_rom_timing_enabled() && phys >= 0x1FC00000u && phys <= 0x1FC7FFFFu) {
+            psx_cpu_charge(g_psx_rom_access[size >= 4u ? 2 : size == 2u ? 1 : 0]);
+            return;
+        }
+        psx_cpu_charge(psx_mmio_read_wait(phys, size));
+        return;
+    }
     /* ReadMemory start (369-370): clear the current give-back slot. */
     cpu->read_absorb[cpu->read_absorb_which] = 0u;
     cpu->read_absorb_which = 0u;
