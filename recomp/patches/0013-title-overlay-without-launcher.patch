+/* Tekken 2 patch 0013: a title layer (psx_title_hooks.h) into the staging
+ * buffer and onto the swapchain. This path copies, so the title gives an
+ * opaque image at swapchain pixels (PsxTitleLayer.opaque); an RGBA swapchain
+ * gets its red and blue swapped on the way. */
+static void vk_title_copy_rect(VkCommandBuffer cb, VkImage sc, const PsxTitleLayer *tl,
+                               int rgba, VkDeviceSize buf_off) {
+    int dw = tl->w, dh = tl->h;
+    if (tl->x < 0 || tl->y < 0) return;
+    if (tl->x + dw > (int)s_sc_extent.width) dw = (int)s_sc_extent.width - tl->x;
+    if (tl->y + dh > (int)s_sc_extent.height) dh = (int)s_sc_extent.height - tl->y;
+    if (dw < 1 || dh < 1) return;
+    uint32_t *dst = (uint32_t *)((uint8_t *)s_osd_map + (size_t)buf_off);
+    const size_t n = (size_t)tl->w * (size_t)tl->h;
+    if (rgba) {
+        for (size_t i = 0; i < n; i++) {
+            const uint32_t v = tl->pixels[i];
+            dst[i] = (v & 0xFF00FF00u) | ((v >> 16) & 0xFFu) | ((v & 0xFFu) << 16);
+        }
+    } else {
+        memcpy(dst, tl->pixels, n * 4u);
+    }
+    VkBufferImageCopy bc = {0};
+    bc.bufferOffset = buf_off;
+    bc.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    bc.imageSubresource.layerCount = 1;
+    bc.imageOffset.x = tl->x;
+    bc.imageOffset.y = tl->y;
+    bc.imageExtent.width = (uint32_t)dw;
+    bc.imageExtent.height = (uint32_t)dh;
+    bc.imageExtent.depth = 1;
+    bc.bufferRowLength = (uint32_t)tl->w;
+    bc.bufferImageHeight = (uint32_t)tl->h;
+    p_vkCmdCopyBufferToImage(cb, s_osd_buf, sc,
+                             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bc);
+}
