+/* Tekken 2 patch 0020: a difftrace run (T2DIFF_SCRIPT, the differential test
+ * harness in tools/diff) drives port 1 from its script and leaves port 2
+ * empty, as DuckStation's regtest and BizHawk TAS movies do. Patch 0012's
+ * title pads would otherwise plug a pad into port 2, and Tekken 2 behaves
+ * differently with two pads (attract and continue screens). Kept clear of
+ * patch 0012's hunks so each patch's applied check stays independent. */
+static int difftrace_port2_empty(int s) {
+    static int armed = -1;
+    if (armed < 0) {
+        const char* e = std::getenv("T2DIFF_SCRIPT");
+        armed = (e && *e) ? 1 : 0;
+    }
+    return s == 1 && armed;
+}
+static int difftrace_empty_pad(PsxNetPad* out) {
+    out->buttons = 0xFFFFu;
+    out->lx = out->ly = out->rx = out->ry = 0x80u;
+    out->analog = 0;
+    out->connected = 0;
+    return 0;
+}
