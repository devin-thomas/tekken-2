+    /* Sectors per track by disc minute (lba + 150 = MSF). */
+    check(cd_timing_sectors_per_track(300) == 8, "spt minute 0", cd_timing_sectors_per_track(300), 8);
+    check(cd_timing_sectors_per_track(4350) == 9, "spt 01:00:00", cd_timing_sectors_per_track(4350), 9);
+    check(cd_timing_sectors_per_track(4349) == 8, "spt 00:59:74", cd_timing_sectors_per_track(4349), 8);
+    check(cd_timing_sectors_per_track(45300) == 11, "spt minute 10", cd_timing_sectors_per_track(45300), 11);
+    check(cd_timing_sectors_per_track(135300) == 15, "spt minute 30", cd_timing_sectors_per_track(135300), 15);
+    check(cd_timing_sectors_per_track(297300) == 20, "spt minute 66", cd_timing_sectors_per_track(297300), 20);
+    check(cd_timing_sectors_per_track(400000) == 20, "spt past the table", cd_timing_sectors_per_track(400000), 20);
+
+    for (size_t i = 0; i < sizeof(k_seeks) / sizeof(k_seeks[0]); i++) {
+        snprintf(name, sizeof name, "seek %d -> %d", k_seeks[i].from, k_seeks[i].to);
+        near_(name, cd_timing_seek_cycles(k_seeks[i].from, k_seeks[i].to, 1), k_seeks[i].measured, 12000);
+    }
+    /* Single speed (seek1x, base 45000): 5 ahead = 7 sectors at 1x. */
+    near_("seek 1x 44998 -> 45005", cd_timing_seek_cycles(44998, 45005, 0), 3216688 - 25000, 12000);
+    near_("seek 1x 44998 -> 65000", cd_timing_seek_cycles(44998, 65000, 0), 11803672 - 25000, 12000);
+
+    /* Pause right after a sector at double speed: (spt - 2) sectors, less
+     * the time since that sector (the command's own 25,000). Measured from
+     * the write: 1,354,728 at minute 0, 2,032,112 at minute 10, 4,064,248
+     * at minute 61. */
+    near_("pause 2x minute 0", 25000 + cd_timing_pause_cycles(1, 1, 300, 25000), 1354728, 100);
+    near_("pause 2x minute 10", 25000 + cd_timing_pause_cycles(1, 1, 45300, 25000), 2032112, 100);
+    near_("pause 2x minute 61", 25000 + cd_timing_pause_cycles(1, 1, 274800, 25000), 4064248, 100);
+    near_("pause 1x minute 30", 25000 + cd_timing_pause_cycles(1, 0, 135300, 25000), 5870624, 100);
+    near_("pause paused", 25000 + cd_timing_pause_cycles(0, 1, 300, 0), 52024, 100);
+
+    /* Init at single speed near the start: the 4,000,000 minimum. From
+     * double speed at 45,404: spin-down plus the sled home (37,675,488
+     * measured from the write, 80,000 of it the first response). */
+    near_("init 1x", 80000 + cd_timing_init_cycles(0, cd_timing_seek_cycles(30, 0, 0)), 4080080, 100);
+    near_("init from 2x",
+          80000 + cd_timing_init_cycles(cd_timing_speed_change_cycles(0), cd_timing_seek_cycles(45404, 0, 0)),
+          37675488, 60000);
+    near_("getid", 25000 + cd_timing_getid_cycles(), 58888, 100);
+    /* Speed change: 0.6 s up, 0.7 s down. */
+    near_("speed up", cd_timing_speed_change_cycles(1), 20321280, 20000);
+    near_("speed down", cd_timing_speed_change_cycles(0), 23708160, 20000);
+
+    /* Holding: after a SeekL to 45000 the head is at 44998 and wraps within
+     * one track (11 sectors at minute 10) behind 45000. */
+    {
+        CdTimingHead h;
+        cd_timing_head_set(&h, 45000, 44998, CD_TIMING_HOLD_SKEW, 1000);
+        check(cd_timing_head_hold(&h, 1000 + 225791, 1) == 44998, "hold before a sector",
+              h.subq, 44998);
+        check(cd_timing_head_hold(&h, 1000 + 225792, 1) == 44999, "hold one sector", h.subq, 44999);
+        check(cd_timing_head_hold(&h, 1000 + 4 * 225792, 1) == 44991, "hold wraps a track back",
+              h.subq, 44991);
+        check(cd_timing_head_hold(&h, 1000 + 15 * 225792, 1) == 44991, "hold a whole track later",
+              h.subq, 44991);
+        /* Measured (holdpause2x 45000): read at 45000, Pause, wait 240,000
+         * cycles more, SeekL 45000 took 2,533,392 from the write. */
+    }
+
+    /* BIOS ROM access times from the delay registers (rom_timing.h). Boot
+     * values: a word 24 cycles (measured 25.4 per load with the load's own
+     * cycle, rom_probe.py). OpenBIOS's COM_DELAY 0000132Ch: a word 32, so an
+     * instruction fetched from ROM takes 33 (measured 99 a pass of the
+     * three-instruction delay loop in initCDRom). */
+    {
+        uint32_t t[3];
+        psx_mem_access_times(PSX_ROM_BIOS_DELAY_DEFAULT, PSX_ROM_COM_DELAY_DEFAULT, t);
+        check(t[0] == 6 && t[1] == 12 && t[2] == 24, "rom 0013243F/00031125 word", t[2], 24);
+        check(t[0] == 6, "rom 0013243F/00031125 byte", t[0], 6);
+        check(t[1] == 12, "rom 0013243F/00031125 half", t[1], 12);
+        psx_mem_access_times(PSX_ROM_BIOS_DELAY_DEFAULT, 0x132Cu, t);
+        check(t[2] == 32, "rom 0013243F/0000132C word", t[2], 32);
+        check(t[0] == 8 && t[1] == 16, "rom 0013243F/0000132C byte+half", t[0] * 100 + t[1], 816);
+        /* A 16-bit device (bit 12) reads a halfword in one access. */
+        psx_mem_access_times(0x0013343Fu, PSX_ROM_COM_DELAY_DEFAULT, t);
+        check(t[1] == t[0] && t[2] == 12, "16-bit bus", t[2], 12);
+    }
+
+    printf("cd_timing_test: %d checks, %d failed\n", s_checks, s_fail);
+    return s_fail ? 1 : 0;
+}
