+/* CD drive timing model (Tekken 2 patch 0008): the arithmetic against
+ * DuckStation ffb33c28 measurements from recomp/tools/cd_timing/
+ * (probe.py, duckstation-ffb33c28.json), and the BIOS ROM access times
+ * (rom_timing.h). Each measured seek carries the
+ * drive's per-seek jitter (17,000..34,000 cycles; the model uses the mean),
+ * so seeks are checked to within 12,000 cycles. */
+
+#include "cd_timing.h"
+#include "rom_timing.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef _WIN32
+#define setenv(k, v, o) _putenv_s((k), (v))
+#define unsetenv(k) _putenv_s((k), "")
+#endif
+
+static int s_fail, s_checks;
+
+static void check(int ok, const char *what, long long got, long long want) {
+    s_checks++;
+    if (!ok) {
+        s_fail++;
+        fprintf(stderr, "FAIL %s: got %lld, want %lld\n", what, got, want);
+    }
+}
+
+static void near_(const char *what, long long got, long long want, long long tol) {
+    long long d = got - want;
+    check(d <= tol && d >= -tol, what, got, want);
