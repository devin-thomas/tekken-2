diff --git a/runtime/include/cd_timing.h b/runtime/include/cd_timing.h
new file mode 100644
index 00000000..b33048b4
--- /dev/null
+++ b/runtime/include/cd_timing.h
@@ -0,0 +1,66 @@
+#ifndef PSXRECOMP_CD_TIMING_H
+#define PSXRECOMP_CD_TIMING_H
+
+/* CD drive timing model (Tekken 2 patch 0008). See cd_timing.c.
+ *
+ * When enabled, cdrom.c takes its latencies from here: a command executes
+ * (and its first response is raised) one controller turn after the guest
+ * writes it, seeks take time by distance and position on the disc, the first
+ * sector of a read waits for the seek, Pause waits for the end of the
+ * revolution, a speed change spins the disc up or down, and Init seeks home.
+ * Disabled, cdrom.c keeps psxrecomp's own constants.
+ *
+ * On by default in the REFERENCE execution profile, off in ENHANCED.
+ * PSX_CD_TIMING=1 or =0 overrides either default. */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* PSX-SPX cdromdrive, "INT1 Rate": 75 sectors a second at single speed. */
+#define CD_TIMING_SECTOR_1X        451584u
+/* Two sectors: a logical seek ends this far before its target (the sector
+ * header it stops on), so a following read reads forward into it. */
+#define CD_TIMING_HOLD_SKEW        2
+
+int  cd_timing_enabled(void);
+void cd_timing_set_enabled(int on);       /* tests and tools; -1 = default */
+
+uint32_t cd_timing_sector_cycles(int double_speed);
+/* Command write to first response (and to the command taking effect). */
+uint32_t cd_timing_ack_cycles(uint8_t cmd);
+/* Sectors on one revolution at `lba` (track-relative, 0 = 00:02:00). */
+int      cd_timing_sectors_per_track(int lba);
+/* From the head at `from` to the head at `to`, no speed change running. */
+uint32_t cd_timing_seek_cycles(int from, int to, int double_speed);
+/* Pause command to its second response. `since_last_sector` only counts
+ * while reading. */
+uint32_t cd_timing_pause_cycles(int reading, int double_speed, int lba,
+                                uint32_t since_last_sector);
+uint32_t cd_timing_speed_change_cycles(int to_double_speed);
+/* Init's second response: the speed change back to single speed plus the
+ * seek home, at least INIT_MIN. */
+uint32_t cd_timing_init_cycles(uint32_t speed_change, uint32_t seek);
+uint32_t cd_timing_getid_cycles(void);
+
+/* Where the head is. While reading it follows the sectors; otherwise it
+ * holds near `lba` (+ `skew`) by jumping back one track per revolution. */
+typedef struct {
+    int      lba;          /* data position: last sector read or seek target */
+    int      subq;         /* head position */
+    int      skew;         /* CD_TIMING_HOLD_SKEW once a sector header is valid */
+    uint64_t since;        /* guest cycle `subq` was last set */
+    uint32_t carry;        /* cycles into the current sector */
+} CdTimingHead;
+
+void cd_timing_head_set(CdTimingHead *h, int lba, int subq, int skew, uint64_t now);
+/* The head position at `now` while holding (not reading), advancing `h`. */
+int  cd_timing_head_hold(CdTimingHead *h, uint64_t now, int double_speed);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/include/rom_timing.h b/runtime/include/rom_timing.h
new file mode 100644
index 00000000..bd5c72c5
--- /dev/null
+++ b/runtime/include/rom_timing.h
@@ -0,0 +1,92 @@
+#ifndef PSXRECOMP_ROM_TIMING_H
+#define PSXRECOMP_ROM_TIMING_H
+
+/* BIOS ROM access time (Tekken 2 patch 0008).
+ *
+ * The BIOS ROM sits on an 8-bit bus (PSX-SPX memorycontrol, "1F801010h -
+ * BIOS ROM Delay/Size (usually 0013243Fh) (512Kbytes, 8bit-bus)"), so every
+ * byte, halfword and word the CPU reads from it, instructions included (the
+ * BIOS's own boot code runs from ROM, uncached), takes several bus cycles.
+ * The time follows the delay/size register and the common delay register
+ * (1F801020h, COM_DELAY): the access time field, the COM0/COM2/COM3 terms it
+ * selects and the bus width give the first and each following byte's cycles
+ * (the nocash formula PSX-SPX's memorycontrol section is drawn from, as
+ * DuckStation ffb33c28 implements it in Bus::CalculateMemoryTiming; read for
+ * behaviour only). With the BIOS's boot values 0013243Fh / 00031125h a word
+ * takes 24 cycles, a halfword 12, a byte 6; OpenBIOS's CD code later writes
+ * COM_DELAY = 0000132Ch, and a word then takes 32.
+ *
+ * Measured on DuckStation ffb33c28: a load from ROM 25.4 cycles a word
+ * against 7.4 from RAM with 00031125h (tools/cd_timing/rom_probe.py), and
+ * OpenBIOS's 50,000-pass delay loop in initCDRom (three instructions fetched
+ * from ROM) 99 cycles a pass with 0000132Ch, 33 an instruction
+ * (measured with Tekken 2's boot). psxrecomp
+ * charged a ROM word less than a RAM word, which let OpenBIOS reach its
+ * first CD command 18.5 million cycles (33 VBlanks) before DuckStation; a
+ * fixed 18 cycles over RAM (the first version of this patch) still ran the
+ * delay loop 1.5 million cycles short and every ROM byte load 15 long.
+ *
+ * Charged here: an uncached instruction fetch from ROM takes the word time
+ * (instead of the 4 of an uncached RAM fetch), and a load from ROM takes the
+ * time of its width, the whole of it a stall (psx_cyc_readmem: no Beetle
+ * completion, fudge or give-back), so a ROM instruction costs what it does
+ * on DuckStation: 1 + 24 cycles, and a byte load 1 + 6, at the boot values.
+ * OpenBIOS's byte-wise memcpy of its shell from ROM (81,220 bytes) took 2
+ * cycles a byte too long with the load's fudge.
+ *
+ * On by default in the REFERENCE execution profile, off in ENHANCED;
+ * PSX_ROM_TIMING=1 or =0 overrides either default. */
+
+#include "execution_profile.h"
+
+#include <stdint.h>
+#include <stdlib.h>
+
+/* Power-on and boot values of 1F801010h and 1F801020h (PSX-SPX). */
+#define PSX_ROM_BIOS_DELAY_DEFAULT 0x0013243Fu
+#define PSX_ROM_COM_DELAY_DEFAULT  0x00031125u
+
+#if defined(PSX_EXECUTION_PROFILE_CONFIG) && !PSX_EXECUTION_ENHANCED
+#define PSX_ROM_TIMING_DEFAULT 1
+#else
+#define PSX_ROM_TIMING_DEFAULT 0
+#endif
+
+static inline int psx_rom_timing_enabled(void) {
+    static int s_on = -1;
+    if (s_on < 0) {
+        const char *e = getenv("PSX_ROM_TIMING");
+        s_on = (e && (e[0] == '0' || e[0] == '1')) ? (e[0] == '1') : PSX_ROM_TIMING_DEFAULT;
+    }
+    return s_on;
+}
+
+/* Byte, halfword and word read times in CPU cycles for a device whose
+ * delay/size register is `delay`, given COM_DELAY `com`. */
+static inline void psx_mem_access_times(uint32_t delay, uint32_t com, uint32_t out[3]) {
+    const int access = (int)((delay >> 4) & 0xFu);
+    const int bus16 = (int)((delay >> 12) & 1u);
+    const int com0 = (int)(com & 0xFu), com2 = (int)((com >> 8) & 0xFu), com3 = (int)((com >> 12) & 0xFu);
+    int first = 0, seq = 0, min = 0;
+    if (delay & (1u << 8))  { first += com0 - 1; seq += com0 - 1; }
+    if (delay & (1u << 10)) { first += com2;     seq += com2; }
+    if (delay & (1u << 11)) min = com3;
+    if (first < 6) first++;
+    first += access + 2;
+    seq += access + 2;
+    if (first < min + 6) first = min + 6;
+    if (seq < min + 2) seq = min + 2;
+    const int t[3] = { first, bus16 ? first : first + seq, bus16 ? first + seq : first + 3 * seq };
+    for (int i = 0; i < 3; i++) out[i] = t[i] > 1 ? (uint32_t)(t[i] - 1) : 0u;
+}
+
+/* Current BIOS ROM byte/halfword/word times (memory.c keeps them in step
+ * with writes to 1F801010h and 1F801020h). */
+extern uint32_t g_psx_rom_access[3];
+
+static inline int psx_is_bios_rom(uint32_t addr) {
+    uint32_t phys = addr & 0x1FFFFFFFu;
+    return phys >= 0x1FC00000u && phys <= 0x1FC7FFFFu;
+}
+
+#endif
