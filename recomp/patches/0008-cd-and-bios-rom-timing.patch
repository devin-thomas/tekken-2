+    endif()
+    add_test(NAME cd_timing_test COMMAND cd_timing_test)
+    set_tests_properties(cd_timing_test PROPERTIES ENVIRONMENT "PSX_CD_TIMING=")
+endif()
+
 # Portable rollback host policy (sched/hist/hash_confirm/snap). Sits next to
 # recomp-net; MotK keeps thin PSX glue (pad↔frame, boot_state, FMV/dig0 gates).
 # Snap ring is also used for local rewind without linking full rbengine/recomp-net.
diff --git a/runtime/src/cd_timing.c b/runtime/src/cd_timing.c
new file mode 100644
index 00000000..ef99880c
--- /dev/null
+++ b/runtime/src/cd_timing.c
@@ -0,0 +1,179 @@
+/* CD drive timing model (Tekken 2 patch 0008).
+ *
+ * Why: before this, psxrecomp's CD answered every command 5000 cycles after
+ * the write, completed seeks in 10,267 cycles, started reads a fixed one or
+ * two sector periods after ReadN and did not model the speed change, so a
+ * faithful (REFERENCE) Tekken 2 run reached the intro 168 VBlanks before
+ * DuckStation and every load 40 to 55 VBlanks early.
+ *
+ * Sources. Structure from documented drive behaviour, PSX-SPX cdromdrive:
+ *  - "CDROM - Response Timings": the first response comes after the
+ *    controller's main loop sees the command; Init does some initialisation
+ *    before its first response. Second responses of Seek/Read/Init depend on
+ *    the seek time and, for Pause, are "about 5 sectors" long.
+ *  - "INT1 Rate": SystemClock*930h/4/44100Hz per sector at single speed,
+ *    half that at double speed (451,584 and 225,792 cycles).
+ *  - Seek timings are "still unknown, and they are probably quite
+ *    complicated": coarse and fine steps, and "the amount of data per spiral
+ *    winding increases towards ends of the disc".
+ *  - "Pause ... during some phases of a seek": rejected with INT5.
+ *  - "Init: Multiple effects at once. Sets mode=20h".
+ * Constants: PSX-SPX gives no seek, speed-change or Init times, so every
+ * number below was measured (psxrecomp PROVENANCE.md rule 4, "When
+ * documentation is silent, measure"): recomp/tools/cd_timing/
+ * probe.py builds a PS-X EXE that times 2,711 CD commands on DuckStation
+ * ffb33c28 with the Tekken 2 disc in the drive, fit.py derives the constants
+ * (constants.json) and model.py checks this arithmetic against every
+ * response (median error 4,400 cycles, the drive's own jitter). DuckStation's
+ * source was read for behaviour only; nothing was copied.
+ *
+ * Not modelled: spin-up from a stopped motor, Stop, Play/CD-DA seeks, the
+ * per-seek jitter (a mean is used), XA/CD-DA streaming beyond the sector
+ * rate. */
+
+#include "cd_timing.h"
+#include "execution_profile.h"
+
+#include <math.h>
+#include <stdlib.h>
+
+/* ---- enable ---- */
+
+#if defined(PSX_EXECUTION_PROFILE_CONFIG) && !PSX_EXECUTION_ENHANCED
+#define CD_TIMING_DEFAULT 1
+#else
+#define CD_TIMING_DEFAULT 0
+#endif
+
+static int s_enabled = -1;
+
+int cd_timing_enabled(void) {
+    if (s_enabled < 0) {
+        const char *e = getenv("PSX_CD_TIMING");
+        if (e && (e[0] == '0' || e[0] == '1'))
+            s_enabled = e[0] == '1';
+        else
+            s_enabled = CD_TIMING_DEFAULT;
+    }
+    return s_enabled;
+}
+
+void cd_timing_set_enabled(int on) { s_enabled = on < 0 ? -1 : (on != 0); }
+
+/* ---- measured constants (tools/cd_timing/constants.json) ---- */
+
+#define ACK_CYCLES          25000u     /* 2,546 first responses, 25,024..25,040 */
+#define ACK_INIT_CYCLES     80000u
+#define SEEK_SETTLE         25137u     /* mean extra time of a seek, 17,024..33,704 */
+#define SHORT_JUMP          1693402u   /* about 0.05 s */
+#define LONG_JUMP           3387176u   /* about 0.1 s */
+#define NEAR_LIMIT          7200       /* sectors; beyond, the sled moves */
+#define SWITCH_A            330.98     /* short/long switch: A + B ln(minute) */
+#define SWITCH_B            (-64.478)
+#define SLED_A              1685351.0  /* sled: A + B ln(d) + C d */
+#define SLED_B              908355.2
+#define SLED_C              53.3106
+#define PAUSE_IDLE_CYCLES   27000u
+#define GETID_CYCLES        33900u
+#define INIT_MIN_CYCLES     4000000u
+#define SPEED_UP_CYCLES     20310000u  /* 0.600 s */
+#define SPEED_DOWN_CYCLES   23710000u  /* 0.700 s */
+/* PSX-SPX "Second Response" minimums for Pause (single, double speed). */
+#define PAUSE_MIN_1X        0x020EAEFu
+#define PAUSE_MIN_2X        0x010477Au
+
+/* Sectors per revolution by disc minute (MSF, the 2 s pregap included),
+ * from Pause after a sector at double speed: (n - 2) sector periods. */
+static const uint8_t k_spt_by_minute[] = {
+     8,  9,  9,  9,  9, 10, 10, 10, 11, 11, 11, 11, 12, 12, 12, 12, 12, 13,
+    13, 13, 13, 13, 13, 13, 14, 14, 14, 14, 15, 15, 15, 15, 15, 16, 16, 16,
+    16, 16, 16, 16, 17, 17, 17, 17, 17, 18, 18, 18, 18, 18, 18, 18, 18, 19,
+    19, 19, 19, 19, 19, 19, 19, 20, 20, 20, 20, 20, 20,
+};
+
+uint32_t cd_timing_sector_cycles(int double_speed) {
+    return double_speed ? CD_TIMING_SECTOR_1X / 2u : CD_TIMING_SECTOR_1X;
+}
+
+uint32_t cd_timing_ack_cycles(uint8_t cmd) {
+    return cmd == 0x0A ? ACK_INIT_CYCLES : ACK_CYCLES;
+}
+
+int cd_timing_sectors_per_track(int lba) {
+    int m = (lba + 150) / 4500;
+    int n = (int)(sizeof(k_spt_by_minute) / sizeof(k_spt_by_minute[0]));
+    if (m < 0) m = 0;
+    if (m >= n) m = n - 1;
+    return k_spt_by_minute[m];
+}
+
+static double switch_distance(int lba) {
+    double m = (lba + 150) / 4500.0;
+    if (m < 1.0) m = 1.0;
+    if (m > 72.0) m = 72.0;
+    return SWITCH_A + SWITCH_B * log(m);
+}
+
+uint32_t cd_timing_seek_cycles(int from, int to, int double_speed) {
+    uint32_t p = cd_timing_sector_cycles(double_speed);
+    int diff = to > from ? to - from : from - to;
+    int spt = cd_timing_sectors_per_track(from);
+    int back = from >= spt ? from - spt : 0;
+    double t;
+    if (from < to && diff <= spt)            /* ahead on this track: read to it */
+        t = (double)p * (diff < 2 ? 2 : diff);
+    else if (from >= to && back <= to)       /* one track jump back, then read */
+        t = (double)p * (to - back < 1 ? 1 : to - back);
+    else if (diff < NEAR_LIMIT)
+        t = diff < switch_distance(from) ? SHORT_JUMP : LONG_JUMP;
+    else
+        t = SLED_A + SLED_B * log((double)diff) + SLED_C * diff;
+    return (uint32_t)t + SEEK_SETTLE;
+}
+
+uint32_t cd_timing_pause_cycles(int reading, int double_speed, int lba,
+                                uint32_t since_last_sector) {
+    if (!reading) return PAUSE_IDLE_CYCLES;
+    int64_t t = (int64_t)(cd_timing_sectors_per_track(lba) - 2) *
+                cd_timing_sector_cycles(double_speed) - since_last_sector;
+    int64_t lo = double_speed ? PAUSE_MIN_2X : PAUSE_MIN_1X;
+    return (uint32_t)(t < lo ? lo : t);
+}
+
+uint32_t cd_timing_speed_change_cycles(int to_double_speed) {
+    return to_double_speed ? SPEED_UP_CYCLES : SPEED_DOWN_CYCLES;
+}
+
+uint32_t cd_timing_init_cycles(uint32_t speed_change, uint32_t seek) {
+    uint64_t t = (uint64_t)speed_change + seek;
+    return t < INIT_MIN_CYCLES ? INIT_MIN_CYCLES : (uint32_t)t;
+}
+
+uint32_t cd_timing_getid_cycles(void) { return GETID_CYCLES; }
+
+/* ---- head position ---- */
+
+void cd_timing_head_set(CdTimingHead *h, int lba, int subq, int skew, uint64_t now) {
+    h->lba = lba;
+    h->subq = subq;
+    h->skew = skew;
+    h->since = now;
+    h->carry = 0;
+}
+
+int cd_timing_head_hold(CdTimingHead *h, uint64_t now, int double_speed) {
+    uint32_t p = cd_timing_sector_cycles(double_speed);
+    if (now <= h->since) return h->subq;
+    uint64_t total = (now - h->since) + h->carry;
+    uint64_t n = total / p;
+    if (n == 0) return h->subq;
+    int anchor = h->lba + h->skew;
+    int spt = cd_timing_sectors_per_track(anchor);
+    int back = anchor >= spt ? anchor - spt : 0;
+    int64_t off = ((int64_t)h->subq - back + (int64_t)(n % (uint64_t)spt)) % spt;
+    if (off < 0) off += spt;
+    h->subq = back + (int)off;
+    h->since = now;
+    h->carry = (uint32_t)(total % p);
+    return h->subq;
+}
diff --git a/runtime/src/cdrom.c b/runtime/src/cdrom.c
index 2250ed0d..dcee257a 100644
--- a/runtime/src/cdrom.c
+++ b/runtime/src/cdrom.c
@@ -13,6 +13,7 @@
 #include "cdrom.h"
 #include "cdrom_irq.h"
