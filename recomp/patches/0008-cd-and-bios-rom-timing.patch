 #include "dma.h"
 #include "spu.h"
 #include "event_ring.h"
@@ -940,7 +941,49 @@ static void response_push(uint8_t val) {
     }
 }
 
+
+/* CD event log for the differential test (recomp/tools/diff):
+ * off unless T2DIFF_CDLOG names a file. One line per event, the same format
+ * the patched DuckStation writes: "C frame cycle cmd n params" when the guest
+ * writes a command, "S frame cycle type lba" when a response is latched,
+ * "I frame cycle type lba" when it is raised to the interrupt controller,
+ * "A frame cycle bits" when the guest acknowledges it. */
+static FILE *cd_event_log(void) {
+    static int state;
+    static FILE *f;
+    if (!state) {
+        const char *path = getenv("T2DIFF_CDLOG");
+        state = 1;
+        if (path && *path) f = fopen(path, "w");
+    }
+    return f;
+}
+
+/* ---- CD drive timing (Tekken 2 patch 0008, cd_timing.c) ----
+ * Only while cd_timing_enabled(): REFERENCE builds, or PSX_CD_TIMING=1. */
+static CdTimingHead s_cdt_head;        /* where the drive head is */
+static uint64_t s_cdt_speed_due;       /* a speed change finishes */
+static uint64_t s_cdt_cmd_written;     /* the queued command was written */
+static uint64_t s_cdt_cmd_due;         /* ... and executes */
+static int      s_cdt_read_seeking;    /* a read has not reached its first sector */
+static int      s_cdt_in_store;        /* inside the guest's CD register store */
+
+static int cdt_double(void) { return (mode_reg & 0x80) != 0; }
+
+static uint32_t cdt_speed_wait(void) {
+    return s_cdt_speed_due > psx_cycle_count
+        ? (uint32_t)(s_cdt_speed_due - psx_cycle_count) : 0u;
+}
+
+static int cdt_head_position(void) {
+    if (reading && !s_cdt_read_seeking) return s_cdt_head.subq;
+    return cd_timing_head_hold(&s_cdt_head, psx_cycle_count, cdt_double());
+}
+
 static void set_irq(int type) {
+    if (cd_event_log())
+        fprintf(cd_event_log(), "S %u %llu %d %d\n", (unsigned)s_frame_count,
+                (unsigned long long)psx_cycle_count, type, (int)last_sector_lba);
     irq_flag = (uint8_t)type;
     /* New visible CD INT generation: it has not yet been presented to INTC,
      * so re-arm the latch (the delayed present below raises it once). */
@@ -950,7 +993,11 @@ static void set_irq(int type) {
      * synchronously inside the guest store that triggered it (see the
      * CDROM_IRQ_PRESENT_DELAY note). Absolute due — not a slice-relative
      * countdown (see pending.due_cyc). */
-    cdrom_irq_present_due = psx_cycle_count + (uint64_t)CDROM_IRQ_PRESENT_DELAY;
+    /* With the timing model a response comes from a scheduled drive event,
+     * as on the hardware, and is raised at once; only one made inside the
+     * guest's own register store keeps the presentation delay. */
+    cdrom_irq_present_due = psx_cycle_count +
+        ((cd_timing_enabled() && !s_cdt_in_store) ? 0u : (uint64_t)CDROM_IRQ_PRESENT_DELAY);
     trace_cdrom('I', 0, (uint32_t)type, 0);
     /* DEQUEUE: CD response/data event fired (aux = CD irq type). */
     event_ring_record_aux(EV_DEQ, (uint8_t)SRC_CD_IRQ, (uint32_t)type);
@@ -1007,6 +1054,9 @@ static void present_cdrom_irq(void) {
     if (cdrom_irq_mask_matches_reason(irq_enable, irq_flag) &&
         !cdrom_intc_request_latched) {
         psx_irq_raise(2, irq_flag); /* IRQ_CDROM; detail = CD response/IRQ type */
+        if (cd_event_log())
+            fprintf(cd_event_log(), "I %u %llu %d %d\n", (unsigned)s_frame_count,
+                    (unsigned long long)psx_cycle_count, (int)irq_flag, (int)last_sector_lba);
         cdrom_intc_request_latched = 1;
         cdrom_intc_latched_generation = cdrom_irq_generation;
         event_ring_record(EV_ISTAT_RAISE, 2 /* IRQ_CDROM bit */);
@@ -1654,6 +1704,16 @@ static void read_seek_landed(void) {
 }
 
 static void start_read_stream(uint8_t cmd) {
+    /* Timing model: the first sector comes once the head has reached the
