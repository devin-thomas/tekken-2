+    {4498, 4501, 699544},        /* ahead within the track: 3 sectors */
+    {4498, 4507, 2057984},       /* 9 sectors, a whole track ahead */
+    {4498, 4508, 1724384},       /* one past it: a short jump */
+    {4498, 4499, 468608},        /* 1 ahead: at least 2 sectors */
+    {4498, 4498, 2057008},       /* on the spot: one track back, 9 forward */
+    {4498, 4490, 251952},        /* one track back, 1 forward */
+    {4498, 4488, 1714992},       /* past one track back: short jump */
+    {134998, 135005, 1602544},
+    {134998, 134986, 704256},
+    {269998, 270020, 1723472},
+    {4498, 4800, 1715592},       /* 302 at minute 1: short (switch near 331) */
+    {4498, 4140, 3414304},       /* 358: long */
