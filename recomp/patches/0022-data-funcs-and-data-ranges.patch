-                runtime_pc(func.start_addr), func.start_addr & 0x1FFFFFFFu);
-            stub.full_code = stub.signature + "\n" + stub.body;
-            stub.line_count = 4;
-            stub.dispatchable = false;
-            results.push_back(stub);
-            continue;
-        }
 
         if (cfgs.count(func.start_addr) == 0) {
             continue; // Skip if no CFG
diff --git a/recompiler/src/config_loader.cpp b/recompiler/src/config_loader.cpp
index ea413b55..e0e7fe56 100644
--- a/recompiler/src/config_loader.cpp
+++ b/recompiler/src/config_loader.cpp
@@ -2161,6 +2161,26 @@ GameConfig load_game_config(const fs::path& config_path_in) {
         }
     }
 
+    std::vector<uint32_t> data_funcs;
+    if (recomp.contains("data_funcs")) {
+        for (const auto& item : toml::find<std::vector<std::string>>(recomp, "data_funcs")) {
+            data_funcs.push_back(parse_hex(item, "recompiler.data_funcs"));
+        }
+    }
+
+    std::vector<std::pair<uint32_t, uint32_t>> data_ranges;
+    if (recomp.contains("data_ranges")) {
+        for (const auto& item : toml::find<toml::array>(recomp, "data_ranges")) {
+            const auto& arr = toml::get<std::vector<std::string>>(item);
+            if (arr.size() != 2) {
+                throw std::runtime_error("[recompiler] data_ranges entries must be [start, end] pairs");
+            }
+            uint32_t start = parse_hex(arr[0], "recompiler.data_ranges.start");
+            uint32_t end = parse_hex(arr[1], "recompiler.data_ranges.end");
+            data_ranges.emplace_back(start, end);
+        }
+    }
+
     // Optional [widescreen] block — per-game hooks for the widescreen hack.
     std::vector<uint32_t> ws_sprite_tag_funcs;
     uint32_t ws_sprite_anchor_addr = 0;
@@ -3127,6 +3147,8 @@ GameConfig load_game_config(const fs::path& config_path_in) {
         parse_draw_distance_clamps(cfg, config_path);
     reject_quality_presets(cfg, config_path);
     loaded.mod_immediate_sites = parse_mod_immediate_sites(cfg, config_path);
+    loaded.data_funcs = std::move(data_funcs);
+    loaded.data_ranges = std::move(data_ranges);
     return loaded;
 }
 
