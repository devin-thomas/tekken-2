     for (uint32_t i = 0; i < s_memprops.memoryTypeCount; i++) {
         if ((type_bits & (1u << i)) &&
@@ -1610,6 +1677,22 @@ static int acquire_present(VkImage *out_sc, VkCommandBuffer *out_cb,
     return 1;
 }
 
+#if defined(__ANDROID__)
+/* Tekken 2 patch 0015: before each present, ask whether the app still has a
+ * window (t2_android_window_state, at the top of the file). In the background
+ * the frame is skipped and the swapchain left alone; back from it, the
+ * swapchain is rebuilt on the new window before anything is drawn into it.
+ * Every present path below calls acquire_present, so the macro covers them. */
+static int t2_acquire_present(VkImage *out_sc, VkCommandBuffer *out_cb,
+                              uint32_t *out_idx, uint32_t *out_frame) {
+    const int ws = t2_android_window_state();
+    if (ws == 1) return 0;
+    if (ws == 2 && !android_rebuild_swapchain(1)) return 0;
+    return acquire_present(out_sc, out_cb, out_idx, out_frame);
+}
+#define acquire_present t2_acquire_present
+#endif
