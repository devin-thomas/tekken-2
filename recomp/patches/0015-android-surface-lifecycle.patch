+#if defined(__ANDROID__)
+/* Tekken 2 patch 0015: every VkSurfaceKHR on Android is made from the window
+ * the app shell reported (android_game_window.c), never from SDL's pointer.
+ * SDL releases that pointer on the UI thread in surfaceDestroyed (Home, the
+ * power button) while this thread can still be presenting; on the Galaxy S21
+ * Ultra a present in that gap failed, patch 0005's rebuild asked SDL for a
+ * new surface and vkCreateAndroidSurfaceKHR got a NULL window (SIGSEGV, the
+ * game restarted from scratch). With no window the call fails cleanly and
+ * the frame is skipped until the app is back. Routed through a macro so
+ * patch 0005's rebuild code stays as it is. */
+#include <android/native_window.h>
+#include <vulkan/vulkan_android.h>
+extern int psx_android_game_window_known(void);
+extern ANativeWindow *psx_android_game_window_acquire(unsigned *generation);
+static bool t2_android_create_surface(SDL_Window *win, VkInstance inst,
+                                      const VkAllocationCallbacks *alloc, VkSurfaceKHR *out);
+#define SDL_Vulkan_CreateSurface(w, i, a, s) t2_android_create_surface((w), (i), (a), (s))
+static unsigned s_t2_surface_gen;   /* window generation s_surface was made from */
+static int t2_android_window_state(void);
+#endif
+
 #define VRAM_W 1024
 #define VRAM_H 512
 
@@ -580,6 +601,52 @@ static void vk_log(const char *msg) { fprintf(stdout, "psxrecomp: vulkan: %s\n",
 
 static int vk_die(const char *why) { fprintf(stdout, "psxrecomp: vulkan: %s\n", why); return 0; }
 
+#if defined(__ANDROID__)
+/* Tekken 2 patch 0015 (see the top of the file). */
+static bool t2_android_create_surface(SDL_Window *win, VkInstance inst,
+                                      const VkAllocationCallbacks *alloc, VkSurfaceKHR *out) {
+    static int waiting;   /* log "no window" once per gap */
+    if (!psx_android_game_window_known())
+        return (SDL_Vulkan_CreateSurface)(win, inst, alloc, out);   /* an older shell */
+    unsigned gen = 0;
+    ANativeWindow *w = psx_android_game_window_acquire(&gen);
+    if (!w) {
+        if (!waiting) fprintf(stdout, "psxrecomp: vulkan: no Android window (in the background); not presenting\n");
+        waiting = 1;
+        *out = VK_NULL_HANDLE;
+        return false;
+    }
+    PFN_vkCreateAndroidSurfaceKHR create = (PFN_vkCreateAndroidSurfaceKHR)
+        p_vkGetInstanceProcAddr(inst, "vkCreateAndroidSurfaceKHR");
+    VkAndroidSurfaceCreateInfoKHR ci = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    ci.window = w;
+    VkResult r = create ? create(inst, &ci, alloc, out) : VK_ERROR_EXTENSION_NOT_PRESENT;
+    ANativeWindow_release(w);   /* the surface holds its own reference */
+    if (r != VK_SUCCESS) {
+        fprintf(stdout, "psxrecomp: vulkan: vkCreateAndroidSurfaceKHR failed (%d)\n", (int)r);
+        *out = VK_NULL_HANDLE;
+        return false;
+    }
+    waiting = 0;
+    s_t2_surface_gen = gen;
+    return true;
+}
+
+/* Before each present: 1 = the app shell has no window (in the background):
+ * skip the frame and leave the swapchain alone; 2 = the window is not the one
+ * s_surface was made from (back from the background): rebuild on the new
+ * one; 0 = carry on. Without this the renderer only noticed a new window
+ * when the old swapchain failed, and could present into a dying one. */
+static int t2_android_window_state(void) {
+    if (!psx_android_game_window_known()) return 0;
+    unsigned gen = 0;
+    ANativeWindow *w = psx_android_game_window_acquire(&gen);
+    if (!w) return 1;
+    ANativeWindow_release(w);
+    return (s_surface == VK_NULL_HANDLE || gen != s_t2_surface_gen) ? 2 : 0;
+}
+#endif
