diff --git a/runtime/src/android_game_window.c b/runtime/src/android_game_window.c
new file mode 100644
index 00000000..d59b076a
--- /dev/null
+++ b/runtime/src/android_game_window.c
@@ -0,0 +1,72 @@
+/* android_game_window.c (Tekken 2 patch 0015): the game view's ANativeWindow,
+ * held by the runtime itself so the Vulkan renderer never builds a surface
+ * from a window Android has already taken away.
+ *
+ * Why: SDL keeps its own pointer to the window and releases it, from the Java
+ * UI thread, in surfaceDestroyed (Home, the power button, the recents list).
+ * The game thread keeps running until it next pumps events. On the Galaxy S21
+ * Ultra on 2026-11-14 a present in that gap failed (the BufferQueue was
+ * abandoned), the renderer asked SDL for a new VkSurfaceKHR, and SDL handed
+ * vkCreateAndroidSurfaceKHR its now-NULL window: SIGSEGV in libvulkan, and the
+ * game restarted from the beginning when Gohan came back to it.
+ *
+ * T2Activity reports its SurfaceView's Surface here from the surface callbacks
+ * (created, changed, destroyed). Each report takes or drops a reference under
+ * a mutex (and bumps a generation when the window object changes), so the
+ * renderer sees "no window: skip presenting" instead of a dangling pointer,
+ * and a window it is handed stays valid while it makes the surface. A shell
+ * that never reports keeps SDL's path (known() == 0). */
+#if defined(__ANDROID__)
+#include <android/native_window.h>
+#include <android/native_window_jni.h>
+#include <jni.h>
+#include <pthread.h>
+#include <stdio.h>
+
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+static ANativeWindow *s_window;   /* one reference held while set */
+static unsigned s_generation;     /* bumped whenever s_window changes */
+static int s_known;               /* the app shell reports its surface */
+
+JNIEXPORT void JNICALL
+Java_com_uppercutlabs_tekken2recomp_T2Activity_nativeGameSurface(JNIEnv *env, jclass cls,
+                                                                 jobject surface)
+{
+    (void)cls;
+    ANativeWindow *next = surface ? ANativeWindow_fromSurface(env, surface) : NULL;
+    ANativeWindow *old = NULL;
+    pthread_mutex_lock(&s_lock);
+    s_known = 1;
+    if (next != s_window) {
+        old = s_window;
+        s_window = next;
+        s_generation++;
+        next = NULL;              /* the reference moved into s_window */
+    }
+    pthread_mutex_unlock(&s_lock);
+    if (next) ANativeWindow_release(next);   /* same window again: drop the extra ref */
+    if (old) ANativeWindow_release(old);
+}
+
+int psx_android_game_window_known(void)
+{
+    pthread_mutex_lock(&s_lock);
+    const int known = s_known;
+    pthread_mutex_unlock(&s_lock);
+    return known;
+}
+
+/* The current window with a reference the caller must release, or NULL while
+ * the app is in the background. *generation gets the window's generation. */
+ANativeWindow *psx_android_game_window_acquire(unsigned *generation)
+{
+    pthread_mutex_lock(&s_lock);
+    ANativeWindow *w = s_window;
+    if (w) ANativeWindow_acquire(w);
+    if (generation) *generation = s_generation;
+    pthread_mutex_unlock(&s_lock);
+    return w;
+}
+#else
+typedef int psx_android_game_window_unused; /* not Android: nothing here */
+#endif
