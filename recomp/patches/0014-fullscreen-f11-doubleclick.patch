+static std::filesystem::path g_overlay_settings_path;  /* settings.toml */
+/* Tekken 2 patch 0014: one fullscreen switch for Alt+Enter, F11 and the
+ * double-click, remembered in settings.toml ([video] fullscreen) so the next
+ * start opens the same way. */
+static bool local_mouse_live(int override_word);
+static void fullscreen_remember(int mode) {
+    if (g_overlay_settings_path.empty()) return;
+    try {
+        PSXRecompV4::UserSettings us = PSXRecompV4::load_user_settings(g_overlay_settings_path);
+        if (us.has_fullscreen && us.fullscreen == mode) return;
+        us.fullscreen = mode; us.has_fullscreen = true;
+        (void)PSXRecompV4::save_user_settings(g_overlay_settings_path, us);
+    } catch (...) {
+    }
+}
+static void fullscreen_toggle_live(const char* why) {
+    const int target = s_window_fullscreen.mode ? 0 : (g_fullscreen ? g_fullscreen : 1);
+    if (psx_window_fullscreen_set(sdl_window, &s_window_fullscreen, target) == 0) {
+        apply_present_cadence();
+        log_present_cadence();
+        host_osd_push(target ? "Fullscreen" : "Windowed", 1500);
+        std::fprintf(stdout, "psxrecomp: %s (%s)\n", target ? "fullscreen" : "windowed", why);
+        fullscreen_remember(target);
+    } else
+        host_osd_push("Fullscreen change failed", 1500);
+}
