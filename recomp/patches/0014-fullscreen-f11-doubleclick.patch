+/* psx_fullscreen_input.h -- Tekken 2 patch 0014: the fullscreen double-click,
+ * from the GGX+ port's in_image_middle (sdl/ggx_main.c;
+ * MIT, Copyright (c) 2026 Lil Gohan).
+ *
+ * A double-click with the left button switches fullscreen only inside the
+ * middle half of the presented picture, so clicks on the bars, at the
+ * picture's edges or on the window's own controls never do. Pure, for the
+ * tests. */
+#ifndef PSX_FULLSCREEN_INPUT_H
+#define PSX_FULLSCREEN_INPUT_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The picture is the largest aspect_num:aspect_den rectangle centred in a
+ * win_w x win_h window (window coordinates, as mouse events give them).
+ * 1 when (x, y) is inside its middle half (the middle half of its width and
+ * of its height). */
+static inline int psx_fs_in_image_middle(int win_w, int win_h, int aspect_num,
+                                         int aspect_den, float x, float y)
+{
+    float iw, ih, cx, cy;
+
+    if (win_w <= 0 || win_h <= 0 || aspect_num <= 0 || aspect_den <= 0) return 0;
+    iw = (float)win_w;
+    ih = iw * (float)aspect_den / (float)aspect_num;
+    if (ih > (float)win_h) {
+        ih = (float)win_h;
+        iw = ih * (float)aspect_num / (float)aspect_den;
+    }
+    cx = (float)win_w * 0.5f;
+    cy = (float)win_h * 0.5f;
+    return x >= cx - iw * 0.25f && x <= cx + iw * 0.25f &&
+           y >= cy - ih * 0.25f && y <= cy + ih * 0.25f;
+}
+
+/* 1 for a fullscreen double-click: the left button's second click, from a
+ * real mouse (not a touch SDL turned into a click). */
+static inline int psx_fs_is_double_click(int is_button_down, int button,
+                                         int clicks, int from_touch)
+{
+    return is_button_down && button == 1 && clicks == 2 && !from_touch;
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif
