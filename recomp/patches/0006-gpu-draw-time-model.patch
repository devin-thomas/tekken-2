+++ b/runtime/src/gpu_timing.c
@@ -0,0 +1,368 @@
+/* gpu_timing.c: how long the GPU takes to draw (Tekken 2 patch 0006).
+ *
+ * Without this model the GPU finished every command the moment it arrived, so
+ * a game that waits for the GPU (Psy-Q DrawSync polls DMA2 busy and GPUSTAT
+ * bit 26) never waited, and a frame whose drawing overran its VBlank never
+ * dropped. With it, each command keeps the GPU busy for the time it takes on
+ * the reference, the 16-word command FIFO fills and drains, and DMA2 waits
+ * for the FIFO the way the hardware's DMA request does.
+ *
+ * Where the facts come from (docs/PROVENANCE.md):
+ *
+ * - Documented in PSX-SPX:
+ *   graphicsprocessingunitgpu, "GPU I/O Ports, DMA Channels, Commands, VRAM":
+ *   the 16-word command FIFO. graphicsprocessingunitgpu, "GPUSTAT" and its
+ *   "Ready Bits" note: bit 26 ready to receive a command word (clear while
+ *   the GPU wants parameters or is busy), bit 28 write FIFO empty, bit 25 the
+ *   DMA request (FIFO not full for GP1(04h)=1, same as bit 28 for 2).
+ *   graphicsprocessingunitgpu, "GP0(E3h..E5h)": these "do not take up space
+ *   in the FIFO", nor does GP0(00h). dmachannels, "DMA Transfer Rates": DMA2
+ *   moves 1 word per clock, and "GPU polygon rendering time is unknown".
+ *   dmachannels, "CPU Operation during DMA": the CPU runs between linked-list
+ *   entries, and a CPU RAM or I/O read stalls while DMA moves data.
+ *
+ * - Measured, because PSX-SPX gives no draw times: every cost below was
+ *   fitted to the DuckStation reference (ffb33c28) with the probe program in
+ *   recomp/tools/gpu_timing/ (probe.py builds a PS-X EXE that
+ *   times GP0 commands with root counter 2; the 290 results are in
+ *   duckstation-ffb33c28.json; model.py is the same arithmetic in Python and
+ *   checks every result to within 30 ticks). runtime/tests/test_gpu_timing.c
+ *   pins a set of them. The measurements show:
+ *     polygons: a setup time by vertex count, shading and texturing, then one
+ *       tick per pixel of the triangle (area, vertices clamped to the drawing
+ *       area), two if textured, and half again if semi-transparent or mask-
+ *       checked. A quad is two triangles with one setup. Dithering and
+ *       texture depth do not change polygon time.
+ *     rectangles: per row, one tick per pixel; texturing adds one per texel
+ *       for 4bpp and for small 8bpp/15bpp rectangles, and a cache-refill cost
+ *       for larger ones (texture_row_extra); semi-transparency or mask check
+ *       half a tick per pixel.
+ *     lines: the longer axis in ticks. Fill: (width/8 + 9) ticks a row.
+ *       VRAM-to-VRAM copy: two ticks a pixel. CPU-to-VRAM data: no time beyond
+ *       its delivery.
+ *     DMA2 linked list: a node header takes 8.75 cycles; a node's words go
+ *       only when the FIFO is empty (the DMA request of GP1(04h)=2); the FIFO
+ *       empties about 13 ticks after the GPU starts its last command.
+ *   The draw-time formulas were derived from these measurements. DuckStation's
+ *   GPU timing was read for behaviour only; no code, table or constant is
+ *   taken from it.
+ *
+ * Not modelled: interlaced drawing that skips the displayed field, GPU
+ * stalls on VRAM reads (GP0(C0h)), and the timing state in savestates. */
+
+#include "gpu_timing.h"
+#include "execution_profile.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- enable ---- */
+
+/* On in a REFERENCE build of a game. Standalone fixtures without an execution
+ * profile keep the old instant GPU unless a test turns the model on. */
+#if defined(PSX_EXECUTION_PROFILE_CONFIG) && !PSX_EXECUTION_ENHANCED
+#define GPU_TIMING_DEFAULT 1
+#else
+#define GPU_TIMING_DEFAULT 0
+#endif
+
+static int s_enabled = -1;
+
+int gpu_timing_enabled(void) {
+    if (s_enabled < 0) {
+        const char *e = getenv("PSX_GPU_TIMING");
+        if (e && (e[0] == '0' || e[0] == '1'))
+            s_enabled = e[0] == '1';
+        else
+            s_enabled = GPU_TIMING_DEFAULT;
+    }
+    return s_enabled;
+}
+
+void gpu_timing_set_enabled(int on) { s_enabled = on < 0 ? -1 : (on != 0); }
+
+/* ---- draw time (measured; see the file comment) ---- */
+
+static const uint16_t k_poly_setup[2][2][2] = {
+    /* [quad][shaded][textured] */
+    { { 42, 220 }, { 332, 489 } },
+    { { 80, 258 }, { 362, 527 } },
+};
+#define RECT_SETUP      10u
+#define FILL_SETUP      40u
+#define FILL_ROW_EXTRA   9u
+
+static int32_t sext11(uint32_t v) {
+    v &= 0x7FFu;
+    return (v & 0x400u) ? (int32_t)v - 0x800 : (int32_t)v;
+}
+
+static int32_t clampi(int32_t v, int32_t lo, int32_t hi) {
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/* Pixels of one triangle with its vertices clamped to the drawing area
+ * (right and bottom edges exclusive, as measured). */
+static uint32_t tri_pixels(const GpuTimingDrawState *st, const int32_t *x,
+                           const int32_t *y) {
+    int32_t cx[3], cy[3];
+    for (int i = 0; i < 3; i++) {
+        cx[i] = clampi(x[i], st->area_left, st->area_right + 1);
+        cy[i] = clampi(y[i], st->area_top, st->area_bottom + 1);
+    }
+    int64_t cross = (int64_t)(cx[1] - cx[0]) * (cy[2] - cy[0]) -
+                    (int64_t)(cx[2] - cx[0]) * (cy[1] - cy[0]);
+    if (cross < 0) cross = -cross;
+    return (uint32_t)(cross / 2);
+}
+
+static uint32_t fill_ticks(uint32_t px, int textured, int slow) {
+    if (textured) px *= 2u;
+    if (slow) px += (px + 1u) / 2u;
+    return px;
+}
+
+static uint32_t polygon_ticks(const GpuTimingDrawState *st,
+                              const uint32_t *w, uint32_t n) {
+    const uint8_t op = (uint8_t)(w[0] >> 24);
+    const int quad = (op & 0x08u) != 0, shaded = (op & 0x10u) != 0;
+    const int textured = (op & 0x04u) != 0;
+    const int slow = (op & 0x02u) != 0 || st->mask_check;
+    const uint32_t step = 1u + (uint32_t)textured + (uint32_t)shaded;
+    int32_t x[4], y[4];
+    const int verts = quad ? 4 : 3;
+    for (int i = 0; i < verts; i++) {
+        uint32_t idx = 1u + (uint32_t)i * step;
+        uint32_t v = idx < n ? w[idx] : 0u;
+        x[i] = sext11(v) + st->offset_x;
+        y[i] = sext11(v >> 16) + st->offset_y;
+    }
+    uint32_t t = k_poly_setup[quad][shaded][textured];
+    t += fill_ticks(tri_pixels(st, x, y), textured, slow);
+    if (quad) t += fill_ticks(tri_pixels(st, x + 1, y + 1), textured, slow);
+    return t;
+}
+
+/* Extra ticks per rectangle row for fetching texels. 4bpp, and 8bpp/15bpp
+ * rectangles that are at most 128 wide and small (up to 2048 / 1024 pixels):
+ * one tick per texel. Wider than 128: 8 ticks per refill, one refill per 4
+ * texels (8bpp) or per 2 (15bpp). Up to 128 wide but larger: one refill per 4
+ * texels, of 4 ticks (8bpp) or 8 (15bpp), times the number of whole widths
+ * that fit in 128. */
+static uint32_t texture_row_extra(uint8_t depth, uint32_t w, uint32_t h) {
+    if (depth == 0u || w == 0u) return w;
+    const int eight = depth == 1u;
+    if (w > 128u) return (w / (eight ? 4u : 2u)) * 8u;
+    if (w * h <= (eight ? 2048u : 1024u)) return w;
+    return (w / 4u) * (eight ? 4u : 8u) * (128u / w);
+}
+
+static uint32_t rect_ticks(const GpuTimingDrawState *st, int32_t x, int32_t y,
+                           uint32_t w, uint32_t h, int textured, int semi) {
+    int32_t x0 = x > st->area_left ? x : st->area_left;
+    int32_t y0 = y > st->area_top ? y : st->area_top;
+    int32_t x1 = x + (int32_t)w, y1 = y + (int32_t)h;
+    if (x1 > st->area_right + 1) x1 = st->area_right + 1;
+    if (y1 > st->area_bottom + 1) y1 = st->area_bottom + 1;
+    if (x1 <= x0 || y1 <= y0) return RECT_SETUP;
+    const uint32_t cw = (uint32_t)(x1 - x0), ch = (uint32_t)(y1 - y0);
+    uint32_t row = cw;
+    if (textured) row += texture_row_extra(st->tex_depth, cw, ch);
+    if (semi || st->mask_check) row += (cw + 1u) / 2u;
+    return RECT_SETUP + row * ch;
+}
+
+uint32_t gpu_timing_line_ticks(const GpuTimingDrawState *st, int32_t ax,
+                               int32_t ay, int32_t bx, int32_t by) {
+    int32_t x0 = ax < bx ? ax : bx, x1 = ax < bx ? bx : ax;
+    int32_t y0 = ay < by ? ay : by, y1 = ay < by ? by : ay;
+    if (x0 < st->area_left) x0 = st->area_left;
+    if (y0 < st->area_top) y0 = st->area_top;
+    if (x1 > st->area_right) x1 = st->area_right;
+    if (y1 > st->area_bottom) y1 = st->area_bottom;
+    if (x1 < x0 || y1 < y0) return 0u;
+    int32_t dx = x1 - x0, dy = y1 - y0;
+    return (uint32_t)(dx > dy ? dx : dy);
+}
+
+uint32_t gpu_timing_command_ticks(const GpuTimingDrawState *st,
+                                  const uint32_t *w, uint32_t n) {
+    if (n == 0u) return 0u;
+    const uint8_t op = (uint8_t)(w[0] >> 24);
+    if (op >= 0x20u && op <= 0x3Fu) return polygon_ticks(st, w, n);
+    if (op >= 0x60u && op <= 0x7Fu) {
+        const int textured = (op & 0x04u) != 0, semi = (op & 0x02u) != 0;
+        uint32_t xy = n > 1u ? w[1] : 0u;
+        int32_t x = sext11(xy) + st->offset_x, y = sext11(xy >> 16) + st->offset_y;
+        uint32_t rw, rh;
+        switch ((op >> 3) & 3u) {
+        case 0: {
+            uint32_t idx = textured ? 3u : 2u;
+            uint32_t wh = idx < n ? w[idx] : 0u;
+            rw = wh & 0x3FFu;
+            rh = (wh >> 16) & 0x1FFu;
+            break;
+        }
+        case 1: rw = rh = 1u; break;
+        case 2: rw = rh = 8u; break;
+        default: rw = rh = 16u; break;
+        }
+        return rect_ticks(st, x, y, rw, rh, textured, semi);
+    }
+    if (op >= 0x40u && op <= 0x5Fu) {
+        const int shaded = (op & 0x10u) != 0;
+        uint32_t a = n > 1u ? w[1] : 0u;
+        uint32_t bi = shaded ? 3u : 2u;
+        uint32_t b = bi < n ? w[bi] : a;
+        return gpu_timing_line_ticks(st,
+            sext11(a) + st->offset_x, sext11(a >> 16) + st->offset_y,
+            sext11(b) + st->offset_x, sext11(b >> 16) + st->offset_y);
+    }
+    if (op == 0x02u && n >= 3u) {
+        uint32_t fw = ((w[2] & 0x3FFu) + 0xFu) & ~0xFu;
+        uint32_t fh = (w[2] >> 16) & 0x1FFu;
+        return FILL_SETUP + (fw / 8u + FILL_ROW_EXTRA) * fh;
+    }
+    if (op >= 0x80u && op <= 0x9Fu && n >= 4u) {
+        uint32_t cw = ((w[3] - 1u) & 0x3FFu) + 1u;
+        uint32_t chh = (((w[3] >> 16) - 1u) & 0x1FFu) + 1u;
+        return 2u * cw * chh;
+    }
+    return 0u;
+}
+
+/* ---- FIFO and busy state ----
+ *
+ * Times are absolute GPU ticks (guest cycle * 2). A command's words sit in the
+ * FIFO from arrival until RELEASE_TICKS after the GPU starts it (measured: a
+ * DMA2 node of NOP words takes 6.5 cycles more than its words to clear the
+ * DMA request). The GPU starts a command when it has finished the previous
+ * one and draws it for its draw time. */
+
+#define RELEASE_TICKS 13u
+#define QUEUE_CAP 32u
+
+typedef struct { uint64_t release; uint32_t words; } QEntry;
+
+static QEntry   s_q[QUEUE_CAP];
+static uint32_t s_q_head, s_q_count;
+static uint32_t s_partial;          /* words of the command being received */
+static uint64_t s_busy_until;       /* ticks */
+static GpuTimingStats s_stats;
+
+void gpu_timing_reset(void) {
+    s_q_head = s_q_count = 0;
+    s_partial = 0;
+    s_busy_until = 0;
+}
+
+static void purge(uint64_t t) {
+    while (s_q_count && s_q[s_q_head].release <= t) {
+        s_q_head = (s_q_head + 1u) % QUEUE_CAP;
+        s_q_count--;
+    }
+}
+
+static uint32_t occupancy(uint64_t t) {
+    purge(t);
+    uint32_t n = s_partial;
+    for (uint32_t i = 0; i < s_q_count; i++)
+        n += s_q[(s_q_head + i) % QUEUE_CAP].words;
+    return n;
+}
+
+void gpu_timing_clear_fifo(uint64_t now) {
+    (void)now;
+    s_q_head = s_q_count = 0;
+    s_partial = 0;
+}
+
+void gpu_timing_word(uint64_t now) {
+    (void)now;
+    s_partial++;
+}
+
+static uint64_t s_clock;
+static int s_clock_set;
+
+void gpu_timing_set_clock(uint64_t now) { s_clock = now; s_clock_set = 1; }
+void gpu_timing_clear_clock(void) { s_clock_set = 0; }
+uint64_t gpu_timing_clock(uint64_t fallback) {
+    return s_clock_set ? s_clock : fallback;
+}
+
+void gpu_timing_command(uint64_t now, uint32_t ticks) {
+    const uint64_t t = now * GPU_TIMING_TICKS_PER_CYCLE;
+    purge(t);
+    const uint64_t start = s_busy_until > t ? s_busy_until : t;
+    const uint64_t release = start + RELEASE_TICKS;
+    s_busy_until = start + ticks;
+    if (s_partial) {
+        QEntry *last = s_q_count
+            ? &s_q[(s_q_head + s_q_count - 1u) % QUEUE_CAP] : NULL;
+        if (last && (last->release == release || s_q_count == QUEUE_CAP)) {
+            last->words += s_partial;
+            if (release > last->release) last->release = release;
+        } else {
+            QEntry *e = &s_q[(s_q_head + s_q_count) % QUEUE_CAP];
+            e->release = release;
+            e->words = s_partial;
+            s_q_count++;
+        }
+        s_partial = 0;
+    }
+    s_stats.commands++;
+    s_stats.busy_ticks += ticks;
+}
+
+int gpu_timing_fifo_empty(uint64_t now) {
+    return occupancy(now * GPU_TIMING_TICKS_PER_CYCLE) == 0u;
+}
+
+int gpu_timing_fifo_full(uint64_t now) {
+    return occupancy(now * GPU_TIMING_TICKS_PER_CYCLE) >= GPU_TIMING_FIFO_WORDS;
+}
+
+int gpu_timing_idle(uint64_t now) {
+    const uint64_t t = now * GPU_TIMING_TICKS_PER_CYCLE;
+    int idle = occupancy(t) == 0u && s_busy_until <= t;
+    if (!idle) s_stats.idle_reads++;
+    return idle;
+}
+
+static uint32_t ticks_to_cycles(uint64_t ticks) {
+    uint64_t c = (ticks + GPU_TIMING_TICKS_PER_CYCLE - 1u) / GPU_TIMING_TICKS_PER_CYCLE;
+    return c > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)c;
+}
+
+uint32_t gpu_timing_cycles_to_fifo_empty(uint64_t now) {
+    const uint64_t t = now * GPU_TIMING_TICKS_PER_CYCLE;
+    purge(t);
+    /* A command split across DMA nodes cannot complete while the DMA waits;
+     * do not wait on its own words. */
+    if (s_partial || !s_q_count) return 0u;
+    const uint64_t last = s_q[(s_q_head + s_q_count - 1u) % QUEUE_CAP].release;
+    return last > t ? ticks_to_cycles(last - t) : 0u;
+}
+
+uint32_t gpu_timing_cycles_to_fifo_room(uint64_t now) {
+    const uint64_t t = now * GPU_TIMING_TICKS_PER_CYCLE;
+    if (occupancy(t) < GPU_TIMING_FIFO_WORDS || !s_q_count) return 0u;
+    const uint64_t first = s_q[s_q_head].release;
+    return first > t ? ticks_to_cycles(first - t) : 0u;
+}
+
+uint32_t gpu_timing_cycles_to_idle(uint64_t now) {
+    const uint64_t t = now * GPU_TIMING_TICKS_PER_CYCLE;
+    uint64_t end = s_busy_until;
+    purge(t);
+    if (s_q_count) {
+        uint64_t r = s_q[(s_q_head + s_q_count - 1u) % QUEUE_CAP].release;
+        if (r > end) end = r;
+    }
+    return end > t ? ticks_to_cycles(end - t) : 0u;
+}
+
+void gpu_timing_get_stats(GpuTimingStats *out) {
+    if (out) *out = s_stats;
+}
