+/* GPU draw time (gpu_timing.c; Tekken 2 patch 0006). The walker's events
+ * run inside an advance call that covers [s_ll_call_base, +cycles]; a word's
+ * guest time is that base plus what the walker has consumed so far, plus any
+ * cycles a timed burst already ran the walker ahead of the device clock.
+ * s_ll_ahead: walker time already spent beyond the device clock (a burst);
+ * s_cpu_stall: guest cycles the CPU was halted by a burst, charged by
+ * psx_devices_service_to_now (dma_take_cpu_stall). */
+static uint64_t s_ll_call_base;
+static uint32_t s_ll_ahead;
+static uint32_t s_cpu_stall;
+static int      s_ll_holding;
+/* A linked-list node header: 8.75 cycles, measured on the DuckStation
+ * reference (recomp/tools/gpu_timing, "ll 1024 empty nodes"). */
+#define DMA_GPU_LL_TIMED_HEADER_X4 35u
+/* Timed walk pacing (REFERENCE; Tekken 2 patch 0006, amended for the VBlank
+ * alignment work): the DMA runs a list in slices of at most 1,000 cycles with
+ * the CPU halted, and the CPU then runs 100 cycles before the next slice, as
+ * DuckStation ffb33c28 does (dma_max_slice_ticks / dma_halt_ticks; PSX-SPX
+ * dmachannels has the CPU halted while DMA moves data but gives no slice).
+ * Holding the CPU for a whole list instead froze guest interrupts for 3.3
+ * frames on Tekken 2's first scene, which kicks DrawOTag on an OT it has not
+ * cleared yet: the list loops at address 0 until the next DrawOTag replaces
+ * it (also as on DuckStation: a kick while a list runs restarts the walk at
+ * the new MADR). */
+#define DMA_GPU_LL_SLICE_CYCLES 1000u
+#define DMA_GPU_LL_HALT_CYCLES  100u
+static uint32_t s_ll_cpu_run;   /* CPU cycles since the last slice */
+
+static int gpu_ll_timed(void) {
+    return gpu_timing_enabled() && !g_psx_render_pass_active;
+}
+
+static uint64_t gpu_ll_now(void) {
+    return s_ll_call_base + gpu_linked_list.call_consumed;
+}
+
 static void gpu_ll_emit_word(void *opaque, uint32_t address, uint32_t word) {
     (void)opaque;
     gpu_set_gp0_source(address);
-    gpu_write_gp0(word);
+    if (gpu_ll_timed()) {
+        gpu_timing_set_clock(gpu_ll_now());
+        gpu_write_gp0(word);
+        gpu_timing_clear_clock();
+    } else {
+        gpu_write_gp0(word);
+    }
+}
+
+/* PSX-SPX dmachannels, "CPU Operation during DMA" and graphicsprocessingunitgpu,
+ * "GPUSTAT" bit 25: with GP1(04h)=2 the DMA request is "write FIFO empty", so a
+ * node's words start only once the FIFO has drained; later words of the same
+ * node wait for room in the 16-word FIFO. */
+static uint32_t gpu_ll_gate(void *opaque, int first_word) {
+    (void)opaque;
+    if (!gpu_ll_timed()) return 0;
+    const uint64_t now = gpu_ll_now();
+    return first_word ? gpu_timing_cycles_to_fifo_empty(now)
+                      : gpu_timing_cycles_to_fifo_room(now);
+}
+
+static uint32_t gpu_ll_cycles_to_event(void) {
+    uint32_t d = dma_gpu_ll_cycles_to_event(&gpu_linked_list);
+    /* Timed walk between slices: the next slice comes after the CPU's turn. */
+    if (d != UINT32_MAX && gpu_ll_timed() && !s_ll_holding && !gpu_linked_list.waiting)
+        d = s_ll_cpu_run >= DMA_GPU_LL_HALT_CYCLES ? 1u : DMA_GPU_LL_HALT_CYCLES - s_ll_cpu_run;
+    /* (a slice already run ahead of the device clock elapses first) */
+    if (d == UINT32_MAX || !s_ll_ahead) return d;
+    return d > UINT32_MAX - s_ll_ahead ? UINT32_MAX : d + s_ll_ahead;
+}
+
+static uint32_t dma_take_cpu_stall(void) {
+    uint32_t c = s_cpu_stall;
+    s_cpu_stall = 0;
+    return c;
 }
 
