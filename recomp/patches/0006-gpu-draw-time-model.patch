index 00000000..0493fc20
--- /dev/null
+++ b/runtime/include/gpu_timing.h
@@ -0,0 +1,80 @@
+#ifndef PSXRECOMP_GPU_TIMING_H
+#define PSXRECOMP_GPU_TIMING_H
+
+/* GPU draw-time model (Tekken 2 patch 0006). See gpu_timing.c.
+ *
+ * When enabled, every GP0 command takes guest time: GPUSTAT bit 26 (ready for
+ * a command) stays clear while the GPU draws, bit 28 (write FIFO empty) while
+ * received commands wait in the 16-word FIFO, and DMA2 waits for the FIFO the
+ * way the hardware's DMA request does. Disabled, the GPU is ready at once, as
+ * psxrecomp always modelled it.
+ *
+ * On by default in the REFERENCE execution profile, off in ENHANCED.
+ * PSX_GPU_TIMING=1 or =0 overrides either default. */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Draw state that changes what a command costs. Coordinates are VRAM
+ * pixels; the drawing area is inclusive, as GP0(E3h)/GP0(E4h) give it. */
+typedef struct {
+    int32_t area_left, area_top, area_right, area_bottom;
+    int32_t offset_x, offset_y;
+    uint8_t tex_depth;       /* GP0(E1h) bits 7-8: 0 4bpp, 1 8bpp, 2 15bpp */
+    uint8_t mask_check;      /* GP0(E6h) bit 1 */
+} GpuTimingDrawState;
+
+/* GPU ticks are half a CPU cycle. */
+#define GPU_TIMING_TICKS_PER_CYCLE 2u
+/* PSX-SPX graphicsprocessingunitgpu, "GPU I/O Ports...": "It (=GP0 only?) has
+ * a 64-byte (16-word) command FIFO buffer." */
+#define GPU_TIMING_FIFO_WORDS 16u
+
+int  gpu_timing_enabled(void);
+void gpu_timing_set_enabled(int on);       /* tests and tools; -1 = default */
+
+/* Draw time of one complete GP0 command in GPU ticks. 0 for commands that
+ * draw nothing (environment, NOP, VRAM transfer headers). */
+uint32_t gpu_timing_command_ticks(const GpuTimingDrawState *st,
+                                  const uint32_t *words, uint32_t nwords);
+/* One polyline segment, (x0,y0)-(x1,y1) with the offset already applied. */
+uint32_t gpu_timing_line_ticks(const GpuTimingDrawState *st, int32_t x0,
+                               int32_t y0, int32_t x1, int32_t y1);
+
+/* Queue state. `now` is the guest cycle at which the word or command arrives.
+ * A command's words enter the FIFO as they arrive (word) and leave it when
+ * the GPU starts the command (command, with its draw time). */
+void gpu_timing_reset(void);
+void gpu_timing_clear_fifo(uint64_t now);  /* GP1(01h) */
+void gpu_timing_word(uint64_t now);
+void gpu_timing_command(uint64_t now, uint32_t ticks);
+/* The guest cycle GP0 words arrive at: `fallback` (the CPU's clock) unless
+ * a DMA transfer has set the time of the word it is delivering. */
+void     gpu_timing_set_clock(uint64_t now);
+void     gpu_timing_clear_clock(void);
+uint64_t gpu_timing_clock(uint64_t fallback);
+
+int      gpu_timing_idle(uint64_t now);          /* GPUSTAT bit 26 */
+int      gpu_timing_fifo_empty(uint64_t now);    /* GPUSTAT bit 28 */
+int      gpu_timing_fifo_full(uint64_t now);
+/* Guest cycles until the FIFO is empty (the DMA request in GP1(04h)=2 mode)
+ * or until it has room for one more word. 0 = now. */
+uint32_t gpu_timing_cycles_to_fifo_empty(uint64_t now);
+uint32_t gpu_timing_cycles_to_fifo_room(uint64_t now);
+uint32_t gpu_timing_cycles_to_idle(uint64_t now);
+
+typedef struct {
+    uint64_t commands;
+    uint64_t busy_ticks;        /* sum of command draw times */
+    uint64_t idle_reads;        /* GPUSTAT reads that saw the GPU busy */
+} GpuTimingStats;
+void gpu_timing_get_stats(GpuTimingStats *out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
