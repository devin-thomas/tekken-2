diff --git a/runtime/tests/test_gpu_timing.c b/runtime/tests/test_gpu_timing.c
new file mode 100644
index 00000000..d5109ab8
--- /dev/null
+++ b/runtime/tests/test_gpu_timing.c
@@ -0,0 +1,194 @@
+/* GPU draw-time model (gpu_timing.c, Tekken 2 patch 0006).
+ *
+ * Each cost below is a DuckStation measurement from
+ * recomp/tools/gpu_timing/duckstation-ffb33c28.json (the
+ * probe's "net" CPU cycles times two, in GPU ticks). The model must land
+ * within the probe's poll jitter (TOL ticks). The queue tests pin the FIFO
+ * and DMA-request rules the DMA2 measurements showed. */
+#include "gpu_timing.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define TOL 30
+static int g_fail;
+
+static GpuTimingDrawState full_area(void) {
+    GpuTimingDrawState st = {0, 0, 1023, 511, 0, 0, 0, 0};
+    return st;
+}
+
+static uint32_t xy(int x, int y) {
+    return ((uint32_t)(y & 0xFFFF) << 16) | (uint32_t)(x & 0xFFFF);
+}
+
+static void expect_near(const char *name, uint32_t got, uint32_t measured) {
+    long d = (long)got - (long)measured;
+    if (d < -TOL || d > TOL) {
+        printf("FAIL %-32s model %u, measured %u\n", name, got, measured);
+        g_fail = 1;
+    } else {
+        printf("ok   %-32s model %u, measured %u\n", name, got, measured);
+    }
+}
+
+static void expect_eq(const char *name, long got, long want) {
+    if (got != want) {
+        printf("FAIL %-32s got %ld, want %ld\n", name, got, want);
+        g_fail = 1;
+    } else {
+        printf("ok   %-32s %ld\n", name, got);
+    }
+}
+
+static uint32_t cost(const GpuTimingDrawState *st, const uint32_t *w, uint32_t n) {
+    return gpu_timing_command_ticks(st, w, n);
+}
+
+static void test_costs(void) {
+    GpuTimingDrawState st = full_area();
+    /* Polygons: right triangles with legs s. */
+    uint32_t mono64[] = {0x20808080, xy(0, 0), xy(64, 0), xy(0, 64)};
+    expect_near("tri mono 64", cost(&st, mono64, 4), 2086);
+    uint32_t mono256[] = {0x20808080, xy(0, 0), xy(256, 0), xy(0, 256)};
+    expect_near("tri mono 256", cost(&st, mono256, 4), 32816);
+    uint32_t semi128[] = {0x22808080, xy(0, 0), xy(128, 0), xy(0, 128)};
+    expect_near("tri mono semi 128", cost(&st, semi128, 4), 12334);
+    uint32_t shaded64[] = {0x30808080, xy(0, 0), 0x406080, xy(64, 0),
+                           0x406080, xy(0, 64)};
+    expect_near("tri shaded 64", cost(&st, shaded64, 6), 2380);
+    uint32_t tex64[] = {0x24808080, xy(0, 0), 0x7F000000, xy(64, 0),
+                        0x00084000, xy(0, 64), 0x00004000};
+    expect_near("tri tex 64", cost(&st, tex64, 7), 4312);
+    uint32_t shtex128[] = {0x34808080, xy(0, 0), 0x7F000000, 0x406080,
+                           xy(128, 0), 0x00080080, 0x406080, xy(0, 128),
+                           0x00008000};
+    expect_near("tri shaded tex 128", cost(&st, shtex128, 9), 16870);
+    uint32_t quad32[] = {0x2C808080, xy(0, 0), 0x7F000000, xy(32, 0),
+                         0x00080020, xy(0, 32), 0x00002000, xy(32, 32),
+                         0x00002020};
+    expect_near("quad tex 32", cost(&st, quad32, 9), 2310);
+    uint32_t degenerate[] = {0x20808080, xy(0, 0), xy(64, 0), xy(128, 0)};
+    expect_near("tri degenerate", cost(&st, degenerate, 4), 42);
+
+    /* Clipping: vertices clamp to the drawing area. */
+    GpuTimingDrawState small = st;
+    small.area_right = 63;
+    small.area_bottom = 63;
+    expect_near("tri 256 clipped to 64x64", cost(&small, mono256, 4), 2086);
+    uint32_t outside[] = {0x20808080, xy(100, 100), xy(164, 100), xy(100, 164)};
+    expect_near("tri outside the area", cost(&small, outside, 4), 42);
+
+    /* The draw offset moves vertices before clipping. */
+    GpuTimingDrawState off = small;
+    off.offset_x = 200;
+    expect_near("tri moved out by offset", cost(&off, mono64, 4), 42);
+
+    /* Rectangles. */
+    uint32_t rect64[] = {0x60808080, xy(0, 0), (64u << 16) | 64u};
+    expect_near("rect mono 64x64", cost(&st, rect64, 3), 4102);
+    uint32_t rect_semi[] = {0x62808080, xy(0, 0), (240u << 16) | 320u};
+    expect_near("rect mono semi 320x240", cost(&st, rect_semi, 3), 115208);
+    uint32_t trect[] = {0x64808080, xy(0, 0), 0x7F000000, (64u << 16) | 64u};
+    expect_near("rect tex4 64x64", cost(&st, trect, 4), 8204);
+    st.tex_depth = 1;
+    expect_near("rect tex8 64x64", cost(&st, trect, 4), 12306);
+    uint32_t trect132[] = {0x64808080, xy(0, 0), 0x7F000000, (16u << 16) | 132u};
+    expect_near("rect tex8 132x16", cost(&st, trect132, 4), 6342);
+    st.tex_depth = 2;
+    uint32_t trect32[] = {0x64808080, xy(0, 0), 0x7F000000, (64u << 16) | 32u};
+    expect_near("rect tex15 32x64", cost(&st, trect32, 4), 18438);
+    expect_near("rect tex15 64x64", cost(&st, trect, 4), 20496);
+    st.tex_depth = 0;
+    uint32_t sprite16[] = {0x7C808080, xy(0, 0), 0x7F000000};
+    expect_near("sprite16 tex", cost(&st, sprite16, 3), 518);
+    st.mask_check = 1;
+    expect_near("rect mono maskcheck 64x64", cost(&st, rect64, 3), 6160);
+    st.mask_check = 0;
+
+    /* Fill, copy, lines. */
+    uint32_t fill[] = {0x02000000, xy(0, 0), (240u << 16) | 320u};
+    expect_near("fill 320x240", cost(&st, fill, 3), 11802);
+    uint32_t fill_big[] = {0x02000000, xy(0, 0), (480u << 16) | 640u};
+    expect_near("fill 640x480", cost(&st, fill_big, 3), 42758);
+    uint32_t copy[] = {0x80000000, xy(0, 256), xy(512, 0), (64u << 16) | 64u};
+    expect_near("copy 64x64", cost(&st, copy, 4), 8190);
+    uint32_t line[] = {0x40808080, xy(0, 0), xy(256, 256)};
+    expect_near("line mono d256", cost(&st, line, 3), 252);
+
+    /* Environment commands draw nothing. */
+    uint32_t e1[] = {0xE1000408};
+    expect_eq("GP0(E1h) ticks", cost(&st, e1, 1), 0);
+}
+
+static void test_queue(void) {
+    gpu_timing_set_enabled(1);
+    gpu_timing_reset();
+    /* A 4-word triangle written at cycle 1000 that draws for 2086 ticks. */
+    for (int i = 0; i < 4; i++) gpu_timing_word(1000);
+    expect_eq("mid-command not idle", gpu_timing_idle(1000), 0);
+    gpu_timing_command(1000, 2086);
+    expect_eq("busy right after", gpu_timing_idle(1001), 0);
+    expect_eq("FIFO empty once started", gpu_timing_fifo_empty(1007), 1);
+    expect_eq("cycles to idle", gpu_timing_cycles_to_idle(1000), 1043);
+    expect_eq("idle after draw time", gpu_timing_idle(1000 + 1043), 1);
+
+    /* Two more triangles queue behind the first: the second waits in the
+     * FIFO until the first ends, so the DMA request (FIFO empty) returns
+     * only then (plus the 13-tick release). */
+    gpu_timing_reset();
+    for (int t = 0; t < 2; t++) {
+        for (int i = 0; i < 4; i++) gpu_timing_word(2000);
+        gpu_timing_command(2000, 2086);
+    }
+    expect_eq("second command waits", gpu_timing_fifo_empty(2010), 0);
+    expect_eq("DMA request after first", gpu_timing_cycles_to_fifo_empty(2000),
+              1043 + 7);
+    expect_eq("idle after both", gpu_timing_cycles_to_idle(2000), 2086);
+
+    /* Sixteen words fill the FIFO; a 17th waits for the first queued
+     * command to start. */
+    gpu_timing_reset();
+    for (int i = 0; i < 4; i++) gpu_timing_word(3000);
+    gpu_timing_command(3000, 20000);                 /* drawing */
+    for (int c = 0; c < 4; c++) {
+        for (int i = 0; i < 4; i++) gpu_timing_word(3001);
+        gpu_timing_command(3001, 100);
+    }
+    expect_eq("FIFO full at 16 words", gpu_timing_fifo_full(3002), 1);
+    /* At cycle 3010 the drawing command has left the FIFO; the four queued
+     * ones (16 words) wait for it to end at tick 26000 (+13 release). */
+    expect_eq("room after the first draw", gpu_timing_cycles_to_fifo_room(3010),
+              (26013 - 6020 + 1) / 2);
+
+    /* GP1(01h) empties the FIFO; GP1(00h) resets everything. */
+    gpu_timing_clear_fifo(3002);
+    expect_eq("FIFO cleared", gpu_timing_fifo_empty(3002), 1);
+    gpu_timing_reset();
+    expect_eq("reset is idle", gpu_timing_idle(0), 1);
+}
+
+static void test_gate(void) {
+    gpu_timing_set_enabled(1);
+    expect_eq("forced on", gpu_timing_enabled(), 1);
+    gpu_timing_set_enabled(0);
+    expect_eq("forced off", gpu_timing_enabled(), 0);
+    gpu_timing_set_enabled(-1);
+    /* A fixture without an execution profile defaults to off unless the
+     * environment says otherwise. */
+    const char *e = getenv("PSX_GPU_TIMING");
+    expect_eq("standalone default", gpu_timing_enabled(),
+              e && e[0] == '1' ? 1 : 0);
+}
+
+int main(void) {
+    test_costs();
+    test_queue();
+    test_gate();
+    if (g_fail) {
+        printf("gpu_timing_test: FAILED\n");
+        return 1;
+    }
+    printf("gpu_timing_test: all passed\n");
+    return 0;
+}
