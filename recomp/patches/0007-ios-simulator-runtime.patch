diff --git a/runtime/src/gl_ios_shims.c b/runtime/src/gl_ios_shims.c
new file mode 100644
index 00000000..14c07f56
--- /dev/null
+++ b/runtime/src/gl_ios_shims.c
@@ -0,0 +1,27 @@
+/* gl_ios_shims.c (Tekken 2 patch 0007): desktop GL 1.x entry points that
+ * gpu_gl_renderer.c calls directly and that iOS's OpenGLES.framework does not
+ * export. The GL backend is never selected on iOS (main.cpp falls back to the
+ * software renderer), so these exist only to let the executable link. */
+#if defined(PSX_IOS)
+#define GLES_SILENCE_DEPRECATION 1
+#include <OpenGLES/ES3/gl.h>
+#include <stdio.h>
+
+static void shim_once(const char *name)
+{
+    static int warned;
+    if (!warned) {
+        warned = 1;
+        fprintf(stderr, "psxrecomp: desktop-only GL call %s on iOS ignored\n", name);
+    }
+}
+
+void glClearDepth(double depth) { glClearDepthf((GLfloat)depth); }
+
+void glGetTexImage(GLenum target, GLint level, GLenum format, GLenum type,
+                   void *pixels)
+{
+    (void)target; (void)level; (void)format; (void)type; (void)pixels;
+    shim_once("glGetTexImage");
+}
+#endif
