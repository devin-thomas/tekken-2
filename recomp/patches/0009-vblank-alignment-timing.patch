diff --git a/runtime/include/spu_dma_timing.h b/runtime/include/spu_dma_timing.h
new file mode 100644
index 00000000..f2180e19
--- /dev/null
+++ b/runtime/include/spu_dma_timing.h
@@ -0,0 +1,40 @@
+#ifndef PSXRECOMP_SPU_DMA_TIMING_H
+#define PSXRECOMP_SPU_DMA_TIMING_H
+
+/* SPU DMA write time on the DuckStation reference (Tekken 2 patch 0009).
+ *
+ * DuckStation ffb33c28 moves a RAM-to-SPU transfer in 16-word blocks, one
+ * each time the SPU's 32-halfword transfer FIFO has drained into SPU RAM.
+ * Measured on Tekken 2's own uploads (difftrace PC log: DMA4 slices and the
+ * DMA IRQ): 29,216 words in 920,756 cycles and 44,240 words in 1,394,480,
+ * that is 504.5 cycles a block after the first (31.53 a word), against the 48
+ * a word of the Beetle model psxrecomp used. Tekken 2's upload before its
+ * first scene finished 0.73 million cycles (1.3 VBlanks) late and moved the
+ * scene's setup a frame. PSX-SPX gives no transfer rate. SPU-to-RAM
+ * transfers keep the Beetle cost (not measured).
+ *
+ * On in REFERENCE builds, off in ENHANCED; PSX_SPU_DMA_TIMING=1/0 overrides
+ * (dma.c). */
+
+#include "execution_profile.h"
+
+#include <stdint.h>
+
+#if defined(PSX_EXECUTION_PROFILE_CONFIG) && !PSX_EXECUTION_ENHANCED
+#define DMA_SPU_TIMING_DEFAULT 1
+#else
+#define DMA_SPU_TIMING_DEFAULT 0
+#endif
+
+#define DMA_SPU_BLOCK_X2      1009u   /* 504.5 cycles a 16-word block */
+#define DMA_SPU_FIRST_CYCLES  43u
+
+/* Cycles from the kick to the completion of a `words`-word RAM-to-SPU DMA. */
+static inline uint32_t dma_spu_write_cycles(uint32_t words) {
+    const uint64_t blocks = ((uint64_t)words + 15u) / 16u;
+    if (blocks == 0) return 0;
+    const uint64_t c = ((blocks - 1u) * DMA_SPU_BLOCK_X2 + 1u) / 2u + DMA_SPU_FIRST_CYCLES;
+    return c > UINT32_MAX ? UINT32_MAX : (uint32_t)c;
+}
+
+#endif
