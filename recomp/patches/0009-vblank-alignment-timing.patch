+static uint32_t s_hw_field;       /* CRTC field, as of the last applied wrap */
+static uint32_t s_hw_bit13;       /* GPUSTAT bit 13, latched at each wrap */
+static uint32_t s_hw_dfield;      /* displayed field, latched at the edge */
+static int      s_hw_wrap_done;   /* this frame's wrap already applied */
+
+static uint32_t hw_line_clamp(uint32_t y) {
+    return y < g_psx_lines_per_frame ? y : g_psx_lines_per_frame;
