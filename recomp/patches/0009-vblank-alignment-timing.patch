     return s_generation;
 }
+
+/* ---- CRTC beam arithmetic (gpu.c's hardware CRTC position) ---- */
+
+void psx_crtc_wrap(uint32_t *field, uint32_t *bit13, int interlace) {
+    if (interlace) {
+        *field ^= 1u;
+        *bit13 = *field ^ 1u;
+    } else {
+        *field = 0u;
+        *bit13 = 0u;
+    }
+}
+
+static uint32_t crtc_clamp(uint32_t y, uint32_t total) { return y < total ? y : total; }
+
+uint32_t psx_crtc_status_bits(const PsxCrtcBeam *b, double raw) {
+    uint32_t field = b->field, bit13 = b->bit13;
+    if (!b->wrap_done && raw >= (double)b->total)
+        psx_crtc_wrap(&field, &bit13, b->interlace);   /* the wrap the beam has passed */
+    const uint32_t line = (uint32_t)(raw >= (double)b->total ? raw - (double)b->total : raw);
+    const int in_vblank = line < crtc_clamp(b->y1, b->total) || line >= crtc_clamp(b->y2, b->total);
+    uint32_t lsb;
+    if (b->interlace && b->vres480)
+        lsb = (b->disp_y + ((in_vblank ? 0u : 1u) & b->dfield)) & 1u;
+    else
+        lsb = (b->disp_y + line) & 1u;
+    return (bit13 << 13) | (lsb << 31);
+}
+
+double psx_crtc_lines_to_vblank(double pos, uint32_t y1, uint32_t old_y2, uint32_t new_y2,
+                                uint32_t total) {
+    const double ny2 = (double)crtc_clamp(new_y2, total);
+    const int in_vblank = pos < (double)crtc_clamp(y1, total) || pos >= (double)crtc_clamp(old_y2, total);
+    if (!in_vblank && pos >= ny2) return 0.0;
+    double to_go = ny2 - pos;
+    if (to_go <= 0.0) to_go += (double)total;
+    return to_go;
+}
diff --git a/runtime/tests/test_vblank_alignment.c b/runtime/tests/test_vblank_alignment.c
new file mode 100644
index 00000000..a9f9e4c6
--- /dev/null
+++ b/runtime/tests/test_vblank_alignment.c
@@ -0,0 +1,130 @@
+/* Tekken 2 patch 0009: the hardware frame period, the CRTC beam that drives
+ * GPUSTAT bits 13 and 31 and the VBlank edge, and the SPU DMA write time.
+ * Values from PSX-SPX "GPU Timings" (263 x 3413 / 314 x 3406 video clocks)
+ * and DuckStation ffb33c28 (video clock 53.693175 / 53.203425 MHz; SPU DMA
+ * measured on Tekken 2's uploads). */
+
+#include "psx_video_timing.h"
+#include "spu_dma_timing.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef _WIN32
+#define setenv(k, v, o) _putenv_s((k), (v))
+#define unsetenv(k) _putenv_s((k), "")
+#endif
+
+static int s_fail, s_checks;
+
+static void check(int ok, const char *what, double got, double want) {
+    s_checks++;
+    if (!ok) {
+        s_fail++;
+        fprintf(stderr, "FAIL %s: got %.4f, want %.4f\n", what, got, want);
+    }
+}
+
+/* The OpenBIOS shell's waitVSync for interlace (shell/gpu.c): returns at the
+ * first beam position where (bit31, bit13) = (1, 0) when lastField is 0, or
+ * (0, 1) when it is 1. Scans one frame from `from` in quarter lines. */
+static double shell_wait(const PsxCrtcBeam *b, double from, int last_field) {
+    for (double r = from; r < from + b->total; r += 0.25) {
+        const uint32_t v = psx_crtc_status_bits(b, r);
+        const int even = (v >> 31) == 0, mask_even = ((v >> 13) & 1u) == 0;
+        if (last_field && even && !mask_even) return r;
+        if (!last_field && !even && mask_even) return r;
+    }
+    return -1.0;
+}
+
+int main(void) {
+    /* Frame period: 60/50 Hz constants with the model off. */
+    psx_video_timing_set_hardware(0);
+    (void)psx_video_timing_set_pal(0);
+    check(g_psx_vblank_cycles == 564480u, "off: ntsc period", g_psx_vblank_cycles, 564480);
+
+    /* On: NTSC 897619 * 451584 / 715909 cycles a frame, alternating floor
+     * and floor + 1 on the exact grid; hblank one line, truncated. */
+    psx_video_timing_set_hardware(1);
+    psx_video_timing_frame_edge();          /* first report starts the grid */
+    {
+        unsigned long long sum = 0;
+        for (int i = 0; i < 715909; i++) {
+            sum += g_psx_vblank_cycles;
+            psx_video_timing_frame_edge();
+        }
+        check(sum == 897619ull * 451584ull, "ntsc grid over 715909 frames", (double)sum,
+              897619.0 * 451584.0);
+    }
+    check(g_psx_vblank_cycles == 566203u || g_psx_vblank_cycles == 566204u, "ntsc period",
+          g_psx_vblank_cycles, 566204);
+    check(g_psx_hblank_cycles == 2152u, "ntsc hblank", g_psx_hblank_cycles, 2152);
+    check(fabs(psx_video_timing_line_cycles() - 2152.866065) < 1e-5, "ntsc line",
+          psx_video_timing_line_cycles(), 2152.866065);
+    (void)psx_video_timing_set_pal(1);
+    check(g_psx_vblank_cycles == 680823u || g_psx_vblank_cycles == 680824u, "pal period",
+          g_psx_vblank_cycles, 680823);
+    check(g_psx_hblank_cycles == 2168u, "pal hblank", g_psx_hblank_cycles, 2168);
+    (void)psx_video_timing_set_pal(0);
+    psx_video_timing_set_hardware(-1);
+    unsetenv("PSX_VIDEO_TIMING");
+    check(psx_video_timing_hardware() == 0, "standalone default off", psx_video_timing_hardware(), 0);
+    setenv("PSX_VIDEO_TIMING", "1", 1);
+    psx_video_timing_set_hardware(-1);
+    check(psx_video_timing_hardware() == 1, "PSX_VIDEO_TIMING=1", psx_video_timing_hardware(), 1);
+    unsetenv("PSX_VIDEO_TIMING");
+
+    /* The wrap. */
+    {
+        uint32_t f = 0, b13 = 1;
+        psx_crtc_wrap(&f, &b13, 0);
+        check(f == 0 && b13 == 0, "wrap, interlace off", f * 10 + b13, 0);
+        psx_crtc_wrap(&f, &b13, 1);
+        check(f == 1 && b13 == 0, "wrap, interlace on", f * 10 + b13, 10);
+        psx_crtc_wrap(&f, &b13, 1);
+        check(f == 0 && b13 == 1, "wrap again", f * 10 + b13, 1);
+    }
+
+    /* OpenBIOS shell, 640x480i, display lines 16..255, area Y 2. A frame
+     * starts at its VBlank edge (line 255, raw 255) and wraps at raw 263.
+     * Frame A: field 0 at the edge, so the displayed field is 1: lastField 0
+     * returns at display start (line 16 after the wrap), as on DuckStation. */
+    {
+        PsxCrtcBeam a = { 263, 16, 255, 2, 1, 1, 0, 0, 1, 1 };
+        check(shell_wait(&a, 255.0, 0) == 279.0, "shell lastField 0: display start",
+              shell_wait(&a, 255.0, 0), 279.0);
+        /* Frame B: field 1 at the edge, displayed field 0: lastField 1
+         * returns at the wrap, when bit 13 turns 1. */
+        PsxCrtcBeam b = { 263, 16, 255, 2, 1, 1, 0, 1, 0, 0 };
+        check(shell_wait(&b, 255.0, 1) == 263.0, "shell lastField 1: the wrap",
+              shell_wait(&b, 255.0, 1), 263.0);
+        /* 240-line progressive: bit 31 is the scanline's parity, bit 13 0. */
+        PsxCrtcBeam p = { 263, 16, 256, 0, 0, 0, 0, 0, 0, 0 };
+        check(psx_crtc_status_bits(&p, 300.0) == (1u << 31), "progressive line 37",
+              psx_crtc_status_bits(&p, 300.0), (double)(1u << 31));
+        check(psx_crtc_status_bits(&p, 301.0) == 0u, "progressive line 38",
+              psx_crtc_status_bits(&p, 301.0), 0);
+    }
+
+    /* Moving Y2: from line 100 in the display area, Y2 256 -> 255 is 155
+     * lines ahead; Y2 -> 50 (already passed) is at once; from line 1 in
+     * vblank, Y2 256 -> 255 is 254 lines ahead. */
+    check(psx_crtc_lines_to_vblank(100.0, 16, 256, 255, 263) == 155.0, "Y2 ahead",
+          psx_crtc_lines_to_vblank(100.0, 16, 256, 255, 263), 155.0);
+    check(psx_crtc_lines_to_vblank(100.0, 16, 256, 50, 263) == 0.0, "Y2 passed",
+          psx_crtc_lines_to_vblank(100.0, 16, 256, 50, 263), 0.0);
+    check(psx_crtc_lines_to_vblank(1.0, 16, 256, 255, 263) == 254.0, "Y2 from vblank",
+          psx_crtc_lines_to_vblank(1.0, 16, 256, 255, 263), 254.0);
+
+    /* SPU DMA write: the two transfers measured on DuckStation. */
+    check(abs((int)dma_spu_write_cycles(29216) - 920756) <= 2, "spu dma 29216 words",
+          dma_spu_write_cycles(29216), 920756);
+    check(abs((int)dma_spu_write_cycles(44240) - 1394480) <= 2, "spu dma 44240 words",
+          dma_spu_write_cycles(44240), 1394480);
+    check(dma_spu_write_cycles(16) == 43u, "spu dma one block", dma_spu_write_cycles(16), 43);
+
+    printf("vblank_alignment_test: %d checks, %d failed\n", s_checks, s_fail);
+    return s_fail ? 1 : 0;
+}
