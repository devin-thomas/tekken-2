+/* ---- hardware frame period (Tekken 2 patch 0009) ----
+ *
+ * The round constants make an NTSC frame 564480 CPU cycles (60 Hz). On the
+ * console the frame is 263 scanlines of 3413 video clocks (PAL 314 of 3406,
+ * PSX-SPX "GPU Timings"), and the video clock is not a whole multiple of the
+ * CPU clock: NTSC 53.693175 MHz, PAL 53.203425 MHz against 33.8688 MHz, the
+ * values DuckStation ffb33c28 uses (GPU::GetCRTCFrequency), so an NTSC frame
+ * is 897619 * 451584 / 715909 = 566203.78 CPU cycles (59.82 Hz) and a PAL
+ * frame 1069484 * 451584 / 709379 = 680823.46. The 0.3% gap gave the guest
+ * 1724 fewer cycles a frame than DuckStation and the console, so CD sectors
+ * (paced in CPU cycles) and CPU-bound work ran into later VBlanks: Tekken 2's
+ * VBlank counter was 5 ahead of DuckStation's by round 1 (issue #437).
+ *
+ * The period alternates between floor and floor + 1 so that the frame edges
+ * stay on the exact rational grid. Timer 1's HBlank clock becomes one
+ * scanline, truncated (NTSC 2152, PAL 2168).
+ *
+ * On by default in the REFERENCE execution profile, off in ENHANCED (which
+ * keeps the 60/50 Hz constants bit for bit); PSX_VIDEO_TIMING=1 or =0
+ * overrides either default. */
+
+#if defined(PSX_EXECUTION_PROFILE_CONFIG) && !PSX_EXECUTION_ENHANCED
+#define PSX_VIDEO_TIMING_DEFAULT 1
+#else
+#define PSX_VIDEO_TIMING_DEFAULT 0
+#endif
+
+#define CPU_PER_CRTC_NUM        451584ull   /* 33868800 / 75 */
+#define CRTC_NTSC_DEN           715909u     /* 53693175 / 75 */
+#define CRTC_PAL_DEN            709379u     /* 53203425 / 75 */
+#define CRTC_NTSC_LINE          3413u
+#define CRTC_PAL_LINE           3406u
+
+static int      s_hw = -1;
+static int      s_hw_applied;
+static uint32_t s_frac;        /* remainder of the rational frame grid */
+
+int psx_video_timing_hardware(void) {
+    if (s_hw < 0) {
+        const char *e = getenv("PSX_VIDEO_TIMING");
+        s_hw = (e && (e[0] == '0' || e[0] == '1')) ? (e[0] == '1')
+                                                   : PSX_VIDEO_TIMING_DEFAULT;
+    }
+    return s_hw;
+}
+
+void psx_video_timing_set_hardware(int on) {
+    s_hw = on < 0 ? -1 : (on != 0);
+    s_hw_applied = 0;
+    s_frac = 0;
+}
+
+static uint64_t hw_frame_num(void) {
+    return s_pal ? (uint64_t)PSX_LINES_PER_FRAME_PAL * CRTC_PAL_LINE * CPU_PER_CRTC_NUM
+                 : (uint64_t)PSX_LINES_PER_FRAME_NTSC * CRTC_NTSC_LINE * CPU_PER_CRTC_NUM;
+}
+
+static uint32_t hw_frame_den(void) {
+    return s_pal ? CRTC_PAL_DEN : CRTC_NTSC_DEN;
+}
+
+/* Period of the frame starting now: floor, plus one when the fraction wraps. */
+static uint32_t hw_next_period(void) {
+    const uint64_t num = hw_frame_num();
+    const uint32_t den = hw_frame_den();
+    uint32_t cycles = (uint32_t)(num / den);
+    uint64_t frac = (uint64_t)s_frac + num % den;
+    if (frac >= den) {
+        frac -= den;
+        cycles++;
+    }
+    s_frac = (uint32_t)frac;
+    return cycles;
+}
+
+static void apply_standard(void) {
+    if (psx_video_timing_hardware()) {
+        s_frac = 0;
+        g_psx_vblank_cycles   = hw_next_period();
+        g_psx_hblank_cycles   = (uint32_t)(((s_pal ? CRTC_PAL_LINE : CRTC_NTSC_LINE) *
+                                            CPU_PER_CRTC_NUM) / hw_frame_den());
+        s_hw_applied = 1;
+    } else {
+        g_psx_vblank_cycles   = s_pal ? PSX_VBLANK_CYCLES_PAL   : PSX_VBLANK_CYCLES_NTSC;
+        g_psx_hblank_cycles   = s_pal ? PSX_HBLANK_CYCLES_PAL   : PSX_HBLANK_CYCLES_NTSC;
+    }
+    g_psx_lines_per_frame = s_pal ? PSX_LINES_PER_FRAME_PAL : PSX_LINES_PER_FRAME_NTSC;
+}
+
 int psx_video_timing_set_pal(int pal) {
     pal = pal ? 1 : 0;
-    if (pal == s_pal)
+    if (pal == s_pal) {
+        if (!s_hw_applied && psx_video_timing_hardware())
+            apply_standard();   /* first report: start the hardware grid */
         return 0;
+    }
     s_pal = pal;
-    g_psx_vblank_cycles   = pal ? PSX_VBLANK_CYCLES_PAL   : PSX_VBLANK_CYCLES_NTSC;
-    g_psx_hblank_cycles   = pal ? PSX_HBLANK_CYCLES_PAL   : PSX_HBLANK_CYCLES_NTSC;
-    g_psx_lines_per_frame = pal ? PSX_LINES_PER_FRAME_PAL : PSX_LINES_PER_FRAME_NTSC;
+    apply_standard();
     s_generation++;
     return 1;
 }
 
+double psx_video_timing_line_cycles(void) {
+    return s_pal ? (double)CRTC_PAL_LINE * (double)CPU_PER_CRTC_NUM / (double)CRTC_PAL_DEN
+                 : (double)CRTC_NTSC_LINE * (double)CPU_PER_CRTC_NUM / (double)CRTC_NTSC_DEN;
+}
+
+void psx_video_timing_frame_edge(void) {
+    if (!psx_video_timing_hardware())
+        return;
+    if (!s_hw_applied) {
+        apply_standard();
+        return;
+    }
+    g_psx_vblank_cycles = hw_next_period();
+}
+
 int psx_video_timing_is_pal(void) {
     return s_pal;
 }
@@ -26,3 +135,41 @@ int psx_video_timing_is_pal(void) {
