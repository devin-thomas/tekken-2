+/* Profile for hosts whose guest can run a few percent slow for seconds at a
+ * time (phones under thermal limits): a lower target sized to the device
+ * callback, room above it for a catch-up burst, producer-rate tracking with a
+ * +/-12% range at a bounded slew, and a half-target restart after a depletion.
+ * Host output policy only: the guest's SPU clock and samples are untouched.
+ * Call after rab_config_defaults and after setting the rates and target. */
+void rab_config_slow_host(rab_config *c, int callback_frames) {
+    const double cb_ms = callback_frames > 0 && c->host_rate > 0.0
+        ? (double)callback_frames * 1000.0 / c->host_rate : 0.0;
+    /* Two device callbacks plus one 60 Hz guest frame must fit under target. */
+    const double floor_ms = 2.0 * cb_ms + 17.0 + 8.0;
+    if (c->target_ms < floor_ms) c->target_ms = floor_ms;
+    c->ring_ms        = c->target_ms * 3.0 < c->target_ms + 160.0
+                            ? c->target_ms + 160.0 : c->target_ms * 3.0;
+    /* 12% covers a guest at ~53 Hz against 59.94 (the Galaxy S21 Ultra's
+     * thermally limited fights logged 53-58 Hz in 10 s windows). Rate
+     * tracking with a 1 s time constant follows a sustained deficit; kp acts
+     * on the fill error before that estimate settles. The 75 ms error
+     * low-pass and an 8 pp/s slew keep each callback's ratio change under
+     * 0.2% (inaudible steps); a guest at full speed stays within ~1%. */
+    c->max_correction = 0.12;
+    c->kp             = 0.10;
+    c->slew_pp_per_s  = 8.0;
+    c->rate_track_s   = 1.0;
+    c->reprime_ms     = c->target_ms * 0.5;
+    c->em_low_ms      = c->target_ms * 0.15;
+    c->em_high_ms     = c->ring_ms - 20.0;
+    /* Recovery (amended 2026-11-14 after the Galaxy's evening session):
+     * after a slow stretch the rate estimate sat at the -12% clamp while the
+     * pacer's catch-up burst refilled the ring, so playback stayed slow, the
+     * fill climbed to ~265 ms and the ring overflowed. The rate term now
+     * only acts in the direction the fill error agrees with (see the
+     * controller), and the fill is capped at 1.8x target: anything above is
+     * late audio, dropped once with a crossfade. */
+    c->high_ms        = c->target_ms * 1.8;
