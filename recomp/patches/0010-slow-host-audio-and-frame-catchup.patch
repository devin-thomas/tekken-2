diff --git a/runtime/tests/test_audio_recovery.c b/runtime/tests/test_audio_recovery.c
new file mode 100644
index 00000000..690b4149
--- /dev/null
+++ b/runtime/tests/test_audio_recovery.c
@@ -0,0 +1,182 @@
+/* Audio bridge recovery after slow stretches (Tekken 2 patch 0010, amended).
+ *
+ * The Galaxy S21 Ultra's evening session on 2026-11-14 (cadence lines every
+ * 10 s) showed the slow-host profile's failure mode: in a slow window the
+ * rate estimate fell to 0.40-0.75 with the correction pinned at -12%, the
+ * fill at 15-30 ms and dozens of underruns; in the next window the pacer's
+ * catch-up burst landed while playback was still slowed, the fill rose to
+ * ~265-300 ms and the ring overflowed (+983 to +3197 frames dropped one at a
+ * time).
+ *
+ * This simulates the host the way the runtime runs it: a wall-clock pacer
+ * with a 12-period debt window (frame_pacing.c), a guest frame's CPU cost and
+ * a present cost per frame, late frames left unshown (at most two in a row,
+ * patch 0010), and 1024-frame device callbacks at 48 kHz. The script mixes
+ * full-speed play, GPU-heavy stretches that frame skip can absorb, CPU-heavy
+ * stretches it cannot, and hitches (a 120-150 ms frame, as a CD load does).
+ * A hitch longer than the reserve gaps whatever the bridge does (the guest
+ * clock stops); the pins are about the recovery after it.
+ *
+ * Pins: with frame skip keeping the guest clock running there is no gap;
+ * the first profile reproduces the overflow and the ~300 ms fill; the
+ * recovery never overflows, keeps the fill within one guest burst of the
+ * 180 ms ceiling, and adds no more than two gaps where the guest is slower
+ * than the bridge may stretch. Prints both profiles' numbers for the record. */
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#define RECOMP_AUDIO_DRC_IMPL
+#include "recomp_audio_drc.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct { double until_s, guest_ms, present_ms, hitch_every_s, hitch_ms; } segment;
+
+typedef struct {
+    uint64_t underruns, overflow, trimmed;
+    double max_fill_ms, guest_hz;
+} sim_result;
+
+static sim_result run(const rab_config *cfg, const segment *seg, int nseg,
+                      double from_s, double to_s) {
+    rab_bridge b;
+    assert(rab_init(&b, cfg) == 0);
+    static int16_t pcm[4096 * 2];
+    static int16_t out[1024 * 2];
+    for (int i = 0; i < 4096; i++) {
+        const int16_t v = (int16_t)(8000.0 * sin(i * 0.0627));
+        pcm[2 * i] = pcm[2 * i + 1] = v;
+    }
+    const double period = 1000.0 / 59.94;
+    const double pull_ms = 1024.0 * 1000.0 / cfg->host_rate;
+    const double spu_per_frame = 44100.0 / 59.94;
+    const double end_ms = seg[nseg - 1].until_s * 1000.0;
+    double now = 0.0, deadline = 0.0, next_pull = pull_ms, spu_debt = 0.0, next_hitch = -1.0;
+    int unshown_run = 0, si = 0;
+    uint64_t frames_in = 0, u0 = 0, o0 = 0, t0 = 0;
+    int counting = 0;
+    sim_result r;
+    memset(&r, 0, sizeof r);
+    while (now < end_ms) {
+        while (si < nseg - 1 && now >= seg[si].until_s * 1000.0) { si++; next_hitch = -1.0; }
+        const segment *s = &seg[si];
+        if (s->hitch_every_s > 0.0 && next_hitch < 0.0) next_hitch = now + s->hitch_every_s * 1000.0;
+        /* one guest frame: CPU work, its SPU output, then present or not */
+        double work = s->guest_ms;
+        if (next_hitch >= 0.0 && now >= next_hitch) {
+            work += s->hitch_ms;
+            next_hitch = now + s->hitch_every_s * 1000.0;
+        }
+        const double frame_end = now + work;
+        /* device callbacks during the frame */
+        while (next_pull <= frame_end) {
+            rab_pull(&b, out, 1024);
+            next_pull += pull_ms;
+            if (counting && b.stats.last_fill_ms > r.max_fill_ms) r.max_fill_ms = b.stats.last_fill_ms;
+        }
+        now = frame_end;
+        spu_debt += spu_per_frame;
+        const int n = (int)spu_debt;
+        spu_debt -= n;
+        rab_push(&b, pcm, n);
+        if (!counting && now >= from_s * 1000.0) {
+            counting = 1;
+            u0 = b.stats.underrun_events; o0 = b.stats.overflow_drops; t0 = b.stats.trimmed_frames;
+            frames_in = 0;
+        }
+        if (counting && now < to_s * 1000.0) frames_in++;
+        if (counting && now >= to_s * 1000.0 && r.guest_hz == 0.0) {
+            r.underruns = b.stats.underrun_events - u0;
+            r.overflow = b.stats.overflow_drops - o0;
+            r.trimmed = b.stats.trimmed_frames - t0;
+            r.guest_hz = (double)frames_in / (to_s - from_s);
+        }
+        /* pacer: present unless a whole period behind (two unshown at most) */
+        if (deadline == 0.0 || now >= deadline + 12.0 * period) deadline = now;   /* re-anchor */
+        const int behind = now >= deadline + period;
+        if (behind && unshown_run < 2) {
+            unshown_run++;
+        } else {
+            unshown_run = 0;
+            const double p_end = now + s->present_ms;
+            while (next_pull <= p_end) { rab_pull(&b, out, 1024); next_pull += pull_ms; }
+            now = p_end;
+        }
+        deadline += period;
+        if (now < deadline) {
+            while (next_pull <= deadline) { rab_pull(&b, out, 1024); next_pull += pull_ms; }
+            now = deadline;
+        }
+    }
+    if (r.guest_hz == 0.0) {   /* the window ran to the end of the script */
+        r.underruns = b.stats.underrun_events - u0;
+        r.overflow = b.stats.overflow_drops - o0;
+        r.trimmed = b.stats.trimmed_frames - t0;
+        r.guest_hz = (double)frames_in / (to_s - from_s);
+    }
+    rab_free(&b);
+    return r;
+}
+
+static void config(rab_config *c, int high) {
+    rab_config_defaults(c);
+    c->channels = 2;
+    c->source_rate = 44100.0;
+    c->host_rate = 48000.0;
+    c->target_ms = 100.0;
+    rab_config_slow_host(c, 1024);
+    if (!high) c->high_ms = 0.0;   /* the profile as first shipped */
+}
+
+static void print(const char *name, sim_result r) {
+    printf("%-44s guest=%.2f Hz underruns=%llu overflow=%llu trimmed=%llu max_fill=%.1f ms\n",
+           name, r.guest_hz, (unsigned long long)r.underruns, (unsigned long long)r.overflow,
+           (unsigned long long)r.trimmed, r.max_fill_ms);
+}
+
+int main(void) {
+    rab_config old_cfg, new_cfg;
+    config(&old_cfg, 0);
+    config(&new_cfg, 1);
+    assert(new_cfg.high_ms == 180.0);
+
+    /* GPU-heavy stretch frame skip absorbs (the old Quick Select cost: 9 ms of
+     * guest work and a 19 ms present). A hitch stops the guest clock itself,
+     * so it is left to the second script. */
+    const segment gpu[] = {
+        { 10.0, 11.0, 3.5, 0.0, 0.0 },
+        { 40.0,  9.0, 19.0, 0.0, 0.0 },
+        { 60.0, 11.0, 3.5, 0.0, 0.0 },
+    };
+    /* CPU-heavy stretches frame skip cannot absorb (a throttled fight: 18-20
+     * ms of guest work), hitches, and full-speed recovery in between: the
+     * evening's 20:07:44-20:08:44 pattern. */
+    const segment cpu[] = {
+        { 10.0, 11.0, 3.5, 0.0, 0.0 },
+        { 20.0, 18.0, 3.5, 3.0, 120.0 },
+        { 30.0, 11.0, 3.5, 0.0, 0.0 },
+        { 40.0, 20.0, 3.5, 2.0, 150.0 },
+        { 50.0, 13.0, 3.5, 2.5, 140.0 },
+        { 70.0, 11.0, 3.5, 0.0, 0.0 },
+    };
+    sim_result a, b2;
+    a = run(&old_cfg, gpu, 3, 10.0, 40.0);  print("first profile, GPU-heavy, frame skip", a);
+    b2 = run(&new_cfg, gpu, 3, 10.0, 40.0); print("recovery, GPU-heavy, frame skip", b2);
+    assert(b2.guest_hz > 59.5);              /* frame skip keeps the clock */
+    assert(b2.underruns == 0 && b2.overflow == 0);
+    assert(b2.max_fill_ms <= new_cfg.high_ms + 40.0);
+
+    a = run(&old_cfg, cpu, 6, 10.0, 70.0);  print("first profile, CPU-heavy + hitches", a);
+    b2 = run(&new_cfg, cpu, 6, 10.0, 70.0); print("recovery, CPU-heavy + hitches", b2);
+    assert(b2.overflow == 0);
+    /* The guest really is 5-17% slow here, past the +/-12% the bridge may
+     * stretch, so gaps remain; the recovery must not add to them. */
+    assert(b2.underruns <= a.underruns + 2);
+    assert(a.overflow > 0 && a.max_fill_ms > 250.0);   /* the evening's failure */
+    assert(b2.max_fill_ms <= new_cfg.high_ms + 40.0);
+
+    puts("PASS audio recovery: no gap while the guest clock runs, no overflow, fill capped");
+    return 0;
+}
diff --git a/runtime/tests/test_audio_slow_host.c b/runtime/tests/test_audio_slow_host.c
new file mode 100644
index 00000000..24fe30dd
--- /dev/null
+++ b/runtime/tests/test_audio_slow_host.c
@@ -0,0 +1,168 @@
+/* Audio bridge against a guest that runs slow (Tekken 2 patch 0010).
+ *
+ * Simulates the real pipeline on a 0.25 ms clock: the guest pushes one
+ * frame's SPU output (44100 / 59.94 = 735.7 samples) per guest frame at a
+ * scripted guest rate, and the device pulls 1024-frame callbacks at 48 kHz.
+ * Counts depletions (audible gaps), dropped frames and the largest
+ * correction step between callbacks (pitch glide).
+ *
+ * Pins: the historical defaults are unchanged for a steady guest (desktop);
+ * they gap with a guest a few percent slow (the Galaxy report); the
+ * slow-host profile plays the same scripts without a gap or a dropped
+ * frame. */
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#define RECOMP_AUDIO_DRC_IMPL
+#include "recomp_audio_drc.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef double (*rate_fn)(double t_s);
+
+typedef struct {
+    uint64_t underruns;     /* after the first prime */
+    uint64_t overflow;
+    double   max_corr;
+    double   max_step;      /* largest |corr| change between callbacks */
+    double   min_fill_ms;
+} sim_result;
+
+static sim_result run(const rab_config *cfg, rate_fn guest_hz, double seconds,
+                      double stall_at_s, double stall_ms) {
+    rab_bridge b;
+    assert(rab_init(&b, cfg) == 0);
+    static int16_t pcm[2048 * 2];
+    static int16_t out[1024 * 2];
+    for (int i = 0; i < 2048; i++) {
+        const int16_t v = (int16_t)(8000.0 * sin(i * 0.0627));
+        pcm[2 * i] = pcm[2 * i + 1] = v;
+    }
+    const double dt = 0.25;               /* ms */
+    const double pull_ms = 1024.0 * 1000.0 / cfg->host_rate;
+    const double spu_per_frame = 44100.0 / 59.94;
+    /* sched is the frame pacer's deadline (one period per guest frame);
+     * a frame cannot start before the host is free. After a stall the pacer
+     * repays its debt with unpaced frames (4 ms each here). */
+    double sched = 0.0, next_guest = 0.0, next_pull = pull_ms, spu_debt = 0.0;
+    double prev_corr = 0.0;
+    int stalled = 0;
+    sim_result r = {0};
+    r.min_fill_ms = 1e9;
+    uint64_t base_underruns = 0;
+    int counting = 0;
+    for (double t = 0.0; t < seconds * 1000.0; t += dt) {
+        if (stall_ms > 0.0 && !stalled && t >= stall_at_s * 1000.0) {
+            next_guest = t + stall_ms;   /* host busy: no guest frame */
+            stalled = 1;
+        }
+        while (t >= next_guest) {
+            spu_debt += spu_per_frame;
+            const int n = (int)spu_debt;
+            spu_debt -= n;
+            rab_push(&b, pcm, n);
+            sched += 1000.0 / guest_hz(t / 1000.0);
+            next_guest = sched > next_guest + 4.0 ? sched : next_guest + 4.0;
+        }
+        if (t >= next_pull) {
+            rab_pull(&b, out, 1024);
+            next_pull += pull_ms;
+            if (!counting && b.primed) {
+                counting = 1;
+                base_underruns = b.stats.underrun_events;
+            }
+            if (counting) {
+                const double c = fabs(b.stats.last_correction);
+                if (c > r.max_corr) r.max_corr = c;
+                const double step = fabs(b.stats.last_correction - prev_corr);
+                if (step > r.max_step) r.max_step = step;
+                if (b.stats.last_fill_ms < r.min_fill_ms)
+                    r.min_fill_ms = b.stats.last_fill_ms;
+            }
+            prev_corr = b.stats.last_correction;
+        }
+    }
+    r.underruns = b.stats.underrun_events - base_underruns;
+    r.overflow = b.stats.overflow_drops;
+    rab_free(&b);
+    return r;
+}
+
+static double steady(double t) { (void)t; return 59.94; }
+static double slow56(double t) { (void)t; return 56.0; }
+/* The Galaxy's log: 10 s windows between 53 and 58.5 Hz, a few seconds at a
+ * time, and short full-speed stretches. */
+static double galaxy(double t) {
+    const double pattern[] = {57.7, 55.1, 53.2, 58.2, 56.5, 59.5, 54.2, 57.9};
+    return pattern[(int)(t / 3.0) % 8];
+}
+
+static void config(rab_config *c, int slow_host, double target_ms) {
+    rab_config_defaults(c);
+    c->channels = 2;
+    c->source_rate = 44100.0;
+    c->host_rate = 48000.0;
+    c->target_ms = target_ms;
+    if (slow_host) rab_config_slow_host(c, 1024);
+}
+
+static void print(const char *name, sim_result r) {
+    printf("%-34s underruns=%llu overflow=%llu max_corr=%.4f max_step=%.5f "
+           "min_fill=%.1f ms\n", name, (unsigned long long)r.underruns,
+           (unsigned long long)r.overflow, r.max_corr, r.max_step, r.min_fill_ms);
+}
+
+int main(void) {
+    rab_config desk, phone;
+    config(&desk, 0, 180.0);
+    config(&phone, 1, 100.0); /* the Android default */
+
+    /* Profile shape. */
+    assert(phone.target_ms == 100.0);
+    assert(phone.ring_ms >= 300.0 && phone.max_correction == 0.12);
+    assert(phone.reprime_ms == 50.0 && phone.rate_track_s > 0.0);
+    rab_config tiny;
+    config(&tiny, 1, 30.0); /* below two 21 ms callbacks + a frame: raised */
+    assert(tiny.target_ms >= 2.0 * 1024 * 1000.0 / 48000.0 + 17.0);
+
+    /* Desktop defaults, steady guest: unchanged behaviour. */
+    sim_result r = run(&desk, steady, 60.0, 0, 0);
+    print("desktop defaults, 59.94 Hz", r);
+    assert(r.underruns == 0 && r.overflow == 0 && r.max_corr <= 0.005 + 1e-9);
+
+    /* Desktop defaults, guest 6.6% slow: the reported gaps. */
+    r = run(&desk, slow56, 60.0, 0, 0);
+    print("desktop defaults, 56 Hz", r);
+    assert(r.underruns > 0);
+    r = run(&desk, galaxy, 60.0, 0, 0);
+    print("desktop defaults, Galaxy pattern", r);
+    assert(r.underruns > 0);
+
+    /* Slow-host profile: no gap, no dropped frame, gentle glide. */
+    r = run(&phone, steady, 60.0, 0, 0);
+    print("slow-host, 59.94 Hz", r);
+    assert(r.underruns == 0 && r.overflow == 0 && r.max_corr < 0.02);
+    r = run(&phone, slow56, 60.0, 0, 0);
+    print("slow-host, 56 Hz", r);
+    assert(r.underruns == 0 && r.overflow == 0);
+    r = run(&phone, galaxy, 90.0, 0, 0);
+    print("slow-host, Galaxy pattern", r);
+    assert(r.underruns == 0 && r.overflow == 0);
+    /* 8 pp/s slew at 21.3 ms callbacks: at most ~0.0017 per callback. */
+    assert(r.max_step < 0.002);
+    /* A stall shorter than the target, then the pacer's catch-up burst: the
+     * reserve covers it and the burst lands in the ring's headroom. */
+    r = run(&phone, steady, 30.0, 10.0, 80.0);
+    print("slow-host, 80 ms stall + catch-up", r);
+    assert(r.underruns == 0 && r.overflow == 0);
+    /* A stall longer than the reserve gaps once (nothing to play), restarts
+     * at half the target and drops nothing. */
+    r = run(&phone, steady, 30.0, 10.0, 150.0);
+    print("slow-host, 150 ms stall + catch-up", r);
+    assert(r.overflow == 0 && r.underruns <= 1);
+
+    puts("PASS slow-host audio bridge: desktop unchanged, slow guest gap-free");
+    return 0;
+}
