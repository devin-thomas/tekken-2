+/* Late-frame present skip ("unshown" frames; Tekken 2 patch 0010). When the
+ * wall-clock pacer is a whole frame period or more behind, the guest frame
+ * that just finished is not presented: the host's upload, scaling and swap
+ * are skipped and the next guest frame starts at once, so the guest keeps its
+ * 59.94 Hz clock and the SPU keeps producing audio at real time; only the
+ * picture drops a frame. At most two frames in a row go unshown. Guest work
+ * (CPU, GPU rasterisation into emulated VRAM, SPU) is never skipped: only the
+ * host present. Default on for Android; PSX_PRESENT_CATCHUP=1/0 overrides on
+ * any platform. Offline wall-paced play only (no netplay, turbo, headless). */
+static uint64_t g_present_unshown = 0;
+static int g_present_catchup_skip = 0;
+static uint64_t g_present_last_pacer_exit = 0;
+
+static int present_catchup_enabled(void) {
+    static int v = -1;
+    if (v < 0) {
+#if defined(__ANDROID__)
+        v = 1;
+#else
+        v = 0;
+#endif
+        if (const char *e = std::getenv("PSX_PRESENT_CATCHUP"); e && *e)
+            v = (*e != '0') ? 1 : 0;
+    }
+    return v;
+}
+
+/* Decide before frame_pacer_wait advances the deadline. */
+static void present_catchup_decide(uint64_t now) {
+    static int consecutive = 0;
+    g_present_catchup_skip = 0;
+    const uint64_t freq = SDL_GetPerformanceFrequency();
+    const uint64_t period = (uint64_t)((double)freq * g_frame_period_ms / 1000.0);
+    const uint64_t deadline = s_frame_pacer.next_deadline;
+    /* Beyond 12 periods frame_pacer_wait forgives the debt (re-anchors), so
+     * skipping there would only drop pictures without repaying anything. */
+    const int behind = present_catchup_enabled() && deadline && period &&
+        now >= deadline + period && now < deadline + period * 12u;
+    if (behind && consecutive < 2) {
+        ++consecutive;
+        g_present_catchup_skip = 1;
+        ++g_present_unshown;
+    } else {
+        consecutive = 0;
+    }
+}
+
+#if defined(__ANDROID__)
+extern "C" void psx_android_perf_frame(int64_t work_ns, int64_t target_ns);
+#endif
+
+/* Frame work time (pacer exit to the next pacer entry) for the platform's
+ * performance hint. */
+static void present_note_frame_work(uint64_t pacer_entry) {
+#if defined(__ANDROID__)
+    if (g_present_last_pacer_exit && pacer_entry > g_present_last_pacer_exit) {
+        const double freq = (double)SDL_GetPerformanceFrequency();
+        psx_android_perf_frame(
+            (int64_t)((double)(pacer_entry - g_present_last_pacer_exit) * 1e9 / freq),
+            (int64_t)(g_frame_period_ms * 1e6));
+    }
+#else
+    (void)pacer_entry;
+#endif
+}
