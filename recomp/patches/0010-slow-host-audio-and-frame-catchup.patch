diff --git a/runtime/src/android_perf_hint.c b/runtime/src/android_perf_hint.c
new file mode 100644
index 00000000..447c6cec
--- /dev/null
+++ b/runtime/src/android_perf_hint.c
@@ -0,0 +1,73 @@
+/* android_perf_hint.c (Tekken 2 patch 0010): tells Android how long each
+ * frame's work takes, so the scheduler keeps the game thread on a core and
+ * at a clock that meets the frame period.
+ *
+ * Android's ADPF performance hints (APerformanceHint_*, API 33) take a target
+ * work duration and the measured duration of each frame. Without them the
+ * governor sees a thread that sleeps a little every frame and may run it
+ * slower than it needs; with them it raises the clock only as far as the
+ * frame needs, which also costs less heat than a blanket boost. Loaded with
+ * dlsym, so the app still starts on API 26-32, where this does nothing.
+ * Host policy only: guest timing is not read or changed here. */
+#if defined(__ANDROID__)
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <unistd.h>
+
+typedef struct APerformanceHintManager APerformanceHintManager;
+typedef struct APerformanceHintSession APerformanceHintSession;
+typedef APerformanceHintManager *(*get_manager_fn)(void);
+typedef APerformanceHintSession *(*create_session_fn)(APerformanceHintManager *,
+                                                       const int32_t *, size_t,
+                                                       int64_t);
+typedef int (*update_target_fn)(APerformanceHintSession *, int64_t);
+typedef int (*report_actual_fn)(APerformanceHintSession *, int64_t);
+
+static int s_state; /* 0 = not tried, 1 = active, -1 = unavailable */
+static APerformanceHintSession *s_session;
+static update_target_fn s_update_target;
+static report_actual_fn s_report_actual;
+static int64_t s_target_ns;
+
+static void perf_hint_init(int64_t target_ns) {
+    s_state = -1;
+    void *lib = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+    if (!lib) return;
+    get_manager_fn get_manager =
+        (get_manager_fn)dlsym(lib, "APerformanceHint_getManager");
+    create_session_fn create_session =
+        (create_session_fn)dlsym(lib, "APerformanceHint_createSession");
+    s_update_target =
+        (update_target_fn)dlsym(lib, "APerformanceHint_updateTargetWorkDuration");
+    s_report_actual =
+        (report_actual_fn)dlsym(lib, "APerformanceHint_reportActualWorkDuration");
+    if (!get_manager || !create_session || !s_update_target || !s_report_actual) {
+        fprintf(stdout, "psxrecomp: android: performance hints unavailable (API < 33)\n");
+        return;
+    }
+    APerformanceHintManager *manager = get_manager();
+    const int32_t tid = (int32_t)gettid();
+    s_session = manager ? create_session(manager, &tid, 1, target_ns) : NULL;
+    if (!s_session) {
+        fprintf(stdout, "psxrecomp: android: performance hint session refused\n");
+        return;
+    }
+    s_target_ns = target_ns;
+    s_state = 1;
+    fprintf(stdout, "psxrecomp: android: performance hints on (game thread %d, "
+                    "target %.2f ms)\n", (int)tid, (double)target_ns / 1e6);
+}
+
+/* Called once per presented-or-skipped guest frame on the game thread with
+ * the frame's work time (everything but the pacer's wait) and the period. */
+void psx_android_perf_frame(int64_t work_ns, int64_t target_ns) {
+    if (s_state == 0) perf_hint_init(target_ns);
+    if (s_state != 1 || work_ns <= 0) return;
+    if (target_ns > 0 && target_ns != s_target_ns) {
+        s_update_target(s_session, target_ns);
+        s_target_ns = target_ns;
+    }
+    s_report_actual(s_session, work_ns);
+}
+#endif
